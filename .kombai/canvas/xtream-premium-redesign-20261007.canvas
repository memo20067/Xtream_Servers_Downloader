      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#000000] text-white\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" style=\"font-family:'Noto Sans Arabic','Inter',sans-serif\">\n    <header class=\"border-b border-[#222222]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1360px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <span aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center rounded-sm bg-[#141414] text-[#e50914] text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"bi bi-broadcast\" data-kid=\"1-1-1-1-1-1\" data-name=\"broadcast icon\" style=\"width:1em;height:1em;display:block\">\n                    </i>\n                </span>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand text container\">\n                    <div class=\"text-[19px] font-bold tracking-[-0.03em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title text\">\n                        Xtream\n                    </div>\n                    <div class=\"text-[11px] text-[#8c8c8c]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        مركز المشاهدة\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"header navigation links\">\n                <span class=\"flex items-center gap-2 text-sm text-[#b3b3b3]\" data-kid=\"1-1-1-2-1\" data-name=\"back to library link\">\n                    <i aria-hidden=\"true\" class=\"bi bi-arrow-right text-base\" data-kid=\"1-1-1-2-1-1\" data-name=\"arrow right icon\" style=\"width:1em;height:1em;display:block\">\n                    </i>\n                    العودة إلى المكتبة\n                </span>\n                <span class=\"h-5 w-px bg-[#303030]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation separator\">\n                </span>\n                <span class=\"text-sm text-[#b3b3b3]\" data-kid=\"1-1-1-2-3\" data-name=\"language label text\">\n                    عربي\n                </span>\n                <span aria-label=\"الحساب\" class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#181818] text-[#b3b3b3] text-lg\" data-kid=\"1-1-1-2-4\" data-name=\"user profile button\">\n                    <i class=\"bi bi-person\" data-kid=\"1-1-1-2-4-1\" data-name=\"user icon\" style=\"width:1em;height:1em;display:block\">\n                    </i>\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1360px] px-8 pb-12 pt-7\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-6 flex items-end justify-between\" data-kid=\"1-2-1\" data-name=\"main content header\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and description group\">\n                <h1 class=\"mb-1 text-[27px] font-bold leading-tight tracking-[-0.02em]\" data-kid=\"1-2-1-1-1\" data-name=\"main page headline\">\n                    المشاهدة المباشرة\n                </h1>\n                <p class=\"m-0 text-sm text-[#8c8c8c]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    شغّل قناة من مكتبتك وتابع دليل البرامج عند توفره.\n                </p>\n            </div>\n            <span class=\"flex items-center gap-2 pb-1 text-xs text-[#8c8c8c]\" data-kid=\"1-2-1-2\" data-name=\"playback status indicator\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#666666]\" data-kid=\"1-2-1-2-1\" data-name=\"status dot\">\n                </span>\n                لم يبدأ التشغيل\n            </span>\n        </div>\n        <div class=\"grid grid-cols-[minmax(0,1fr)_330px] items-start gap-8\" data-kid=\"1-2-2\" data-name=\"content grid container\">\n            <section class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"video player section\">\n                <div class=\"relative flex aspect-video items-center justify-center bg-[#050505]\" data-kid=\"1-2-2-1-1\" data-name=\"video player frame\">\n                    <div class=\"flex max-w-[360px] flex-col items-center px-6 text-center\" data-kid=\"1-2-2-1-1-1\" data-name=\"no stream placeholder content\">\n                        <span aria-hidden=\"true\" class=\"mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-[#303030] text-2xl text-[#777777]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"play icon container\">\n                            <i class=\"bi bi-play-fill\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"play fill icon\" style=\"width:1em;height:1em;display:block\">\n                            </i>\n                        </span>\n                        <h2 class=\"mb-2 text-lg font-semibold text-white\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"no stream title text\">\n                            لا يوجد بث محدد\n                        </h2>\n                        <p class=\"mb-5 text-sm leading-6 text-[#8c8c8c]\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"no stream description text\">\n                            اختر قناة من المكتبة لبدء المشاهدة.\n                        </p>\n                        <button class=\"flex h-11 items-center gap-2 rounded-sm bg-[#e50914] px-5 text-sm font-semibold text-white\" data-kid=\"1-2-2-1-1-1-4\" data-name=\"browse channels button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"bi bi-broadcast\" data-kid=\"1-2-2-1-1-1-4-1\" data-name=\"broadcast icon\" style=\"width:1em;height:1em;display:block\">\n                            </i>\n                            استعرض القنوات\n                        </button>\n                    </div>\n                    <div class=\"absolute inset-x-0 bottom-0 flex h-[54px] items-center justify-between border-t border-[#222222] bg-[#090909] px-5\" data-kid=\"1-2-2-1-1-2\" data-name=\"video player controls bar\">\n                        <div class=\"flex items-center gap-4 text-[#666666]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"player playback controls\">\n                            <span aria-label=\"تشغيل غير متاح\" class=\"text-xl\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"play icon button\">\n                                <i class=\"bi bi-play-fill\" data-kid=\"1-2-2-1-1-2-1-1-1\" data-name=\"play fill icon\" style=\"width:1em;height:1em;display:block\">\n                                </i>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"volume icon button\">\n                                <i class=\"bi bi-volume-up\" data-kid=\"1-2-2-1-1-2-1-2-1\" data-name=\"volume up icon\" style=\"width:1em;height:1em;display:block\">\n                                </i>\n                            </span>\n                            <span class=\"text-xs text-[#777777]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-1-3\" data-name=\"playback time text\" data-reason=\"text updated dynamically by playback state\">\n                                —:—\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-4 text-[#777777]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"fullscreen and status controls\">\n                            <span class=\"text-xs\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"stream status text\" data-reason=\"text updated by stream connection state\">\n                                البث غير متصل\n                            </span>\n                            <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"fullscreen icon button\">\n                                <i class=\"bi bi-fullscreen\" data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"fullscreen icon\" style=\"width:1em;height:1em;display:block\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex flex-wrap items-center justify-between gap-5 border-b border-[#222222] pb-6\" data-kid=\"1-2-2-1-2\" data-name=\"channel info section\">\n                    <div class=\"min-w-[280px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"channel metadata\">\n                        <div class=\"mb-2 flex items-center gap-3\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"channel title group\">\n                            <h2 class=\"m-0 text-[22px] font-bold leading-tight\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"channel title\">\n                                لم يتم اختيار قناة\n                            </h2>\n                            <span class=\"border-r border-[#363636] pr-3 text-sm text-[#8c8c8c]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"channel type label\">\n                                البث المباشر\n                            </span>\n                        </div>\n                        <p class=\"m-0 flex items-center gap-2 text-sm text-[#8c8c8c]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"channel source info\">\n                            <i aria-hidden=\"true\" class=\"bi bi-hdd-network\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"network icon\" style=\"width:1em;height:1em;display:block\">\n                            </i>\n                            المصدر غير محدد\n                        </p>\n                    </div>\n                    <span class=\"inline-flex h-10 items-center gap-2 border border-[#333333] px-4 text-sm text-[#b3b3b3]\" data-kid=\"1-2-2-1-2-2\" data-name=\"channel selection helper label\">\n                        <i aria-hidden=\"true\" class=\"bi bi-broadcast-pin\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"broadcast pin icon\" style=\"width:1em;height:1em;display:block\">\n                        </i>\n                        اختر قناة للمتابعة\n                    </span>\n                </div>\n            </section>\n            <aside class=\"flex flex-col gap-5\" data-kid=\"1-2-2-2\" data-name=\"sidebar section\">\n                <section class=\"bg-[#141414] p-5\" data-kid=\"1-2-2-2-1\" data-name=\"epg guide section\">\n                    <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-2-2-2-1-1\" data-name=\"epg header\">\n                        <h2 class=\"m-0 flex items-center gap-2 text-base font-semibold\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"epg title\">\n                            <i aria-hidden=\"true\" class=\"bi bi-calendar2-week text-[#b3b3b3]\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"calendar icon\" style=\"width:1em;height:1em;display:block\">\n                            </i>\n                            دليل البرامج\n                        </h2>\n                        <span class=\"text-[11px] uppercase tracking-[0.12em] text-[#777777]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"epg abbreviation label\">\n                            EPG\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[148px] flex-col items-center justify-center border-t border-[#282828] px-3 pt-4 text-center\" data-kid=\"1-2-2-2-1-2\" data-name=\"epg placeholder content\">\n                        <i aria-hidden=\"true\" class=\"bi bi-calendar-x mb-3 text-2xl text-[#777777]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"calendar error icon\" style=\"width:1em;height:1em;display:block\">\n                        </i>\n                        <p class=\"mb-1 text-sm font-medium text-[#d6d6d6]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"epg error message title\">\n                            بيانات الدليل غير متاحة\n                        </p>\n                        <p class=\"m-0 max-w-[245px] text-xs leading-5 text-[#888888]\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"epg error message detail\">\n                            تظهر معلومات البرامج هنا عند توفرها من مصدر القناة.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"bg-[#141414] p-5\" data-kid=\"1-2-2-2-2\" data-name=\"download options section\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-2-2-2-1\" data-name=\"download header\">\n                        <h2 class=\"m-0 flex items-center gap-2 text-base font-semibold\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"download title\">\n                            <i aria-hidden=\"true\" class=\"bi bi-download text-[#b3b3b3]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"download icon\" style=\"width:1em;height:1em;display:block\">\n                            </i>\n                            تنزيل فيلم أو حلقة\n                        </h2>\n                        <span class=\"text-xs text-[#888888]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"download restriction label\">\n                            للمشتركين\n                        </span>\n                    </div>\n                    <p class=\"mb-3 text-xs leading-5 text-[#888888]\" data-kid=\"1-2-2-2-2-2\" data-name=\"download description\">\n                        يتطلب التنزيل اشتراكًا مدفوعًا. تُعرض الجودة المناسبة بعد التحقق من الملف.\n                    </p>\n                    <p class=\"mb-3 text-[11px] leading-5 text-[#777777]\" data-kid=\"1-2-2-2-2-3\" data-name=\"download options disclaimer text\">\n                        درجات الجودة التالية خيارات يدعمها النظام؛ توفرها يعتمد على الملف.\n                    </p>\n                    <div aria-label=\"خيارات الجودة المتاحة في النظام، غير مؤكدة لهذا الملف\" class=\"mb-3 grid grid-cols-2 gap-2\" data-kid=\"1-2-2-2-2-4\" data-name=\"quality options grid\">\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"quality option 4k\">\n                            <span data-kid=\"1-2-2-2-2-4-1-1\" data-name=\"quality label 4k\">\n                                4K\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-1-2\" data-name=\"quality resolution 4k\">\n                                2160p\n                            </span>\n                        </span>\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"quality option 2k\">\n                            <span data-kid=\"1-2-2-2-2-4-2-1\" data-name=\"quality label 2k\">\n                                2K\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-2-2\" data-name=\"quality resolution 2k\">\n                                1440p\n                            </span>\n                        </span>\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-3\" data-name=\"quality option 1080p\">\n                            <span data-kid=\"1-2-2-2-2-4-3-1\" data-name=\"quality label 1080p\">\n                                Full HD\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-3-2\" data-name=\"quality resolution 1080p\">\n                                1080p\n                            </span>\n                        </span>\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-4\" data-name=\"quality option 720p\">\n                            <span data-kid=\"1-2-2-2-2-4-4-1\" data-name=\"quality label 720p\">\n                                HD\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-4-2\" data-name=\"quality resolution 720p\">\n                                720p\n                            </span>\n                        </span>\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-5\" data-name=\"quality option 480p\">\n                            <span data-kid=\"1-2-2-2-2-4-5-1\" data-name=\"quality label 480p\">\n                                SD\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-5-2\" data-name=\"quality resolution 480p\">\n                                480p\n                            </span>\n                        </span>\n                        <span class=\"flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-6\" data-name=\"quality option 360p\">\n                            <span data-kid=\"1-2-2-2-2-4-6-1\" data-name=\"quality label 360p\">\n                                متوسط\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-6-2\" data-name=\"quality resolution 360p\">\n                                360p\n                            </span>\n                        </span>\n                        <span class=\"col-span-2 flex h-9 items-center justify-between border border-[#303030] px-3 text-xs text-[#c3c3c3]\" data-kid=\"1-2-2-2-2-4-7\" data-name=\"quality option 240p\">\n                            <span data-kid=\"1-2-2-2-2-4-7-1\" data-name=\"quality label 240p\">\n                                جوال منخفض\n                            </span>\n                            <span class=\"text-[#777777]\" data-kid=\"1-2-2-2-2-4-7-2\" data-name=\"quality resolution 240p\">\n                                240p\n                            </span>\n                        </span>\n                    </div>\n                    <button class=\"flex h-11 w-full cursor-not-allowed items-center justify-center gap-2 bg-[#242424] text-sm font-medium text-[#888888]\" data-kid=\"1-2-2-2-2-5\" data-name=\"download restricted button\" disabled=\"\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"bi bi-lock-fill\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"lock icon\" style=\"width:1em;height:1em;display:block\">\n                        </i>\n                        يتطلب اشتراكًا مدفوعًا\n                    </button>\n                </section>\n            </aside>\n        </div>\n    </main>\n</div>\n",
