      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n.player-shell { font-family: 'Inter', 'Noto Sans Arabic', sans-serif; }\n.video-frame { aspect-ratio: 16 / 9; }\n</style>\n<div class=\"player-shell min-h-screen bg-[#000000] text-white antialiased\" data-kid=\"1\" data-name=\"video player application shell\" dir=\"rtl\">\n    <header class=\"border-b border-[#2f2f2f] bg-[#000000]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1344px] items-center justify-between gap-6 px-8 py-4 max-[640px]:flex-wrap max-[640px]:px-4\" data-kid=\"1-1-1\" data-name=\"header layout wrapper\">\n            <div class=\"flex min-w-0 items-center gap-5\" data-kid=\"1-1-1-1\" data-name=\"logo and breadcrumb navigation container\">\n                <a aria-label=\"XTREAM\" class=\"flex shrink-0 items-center gap-2 text-white no-underline\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and label link\" href=\"#\">\n                    <span class=\"text-[25px] font-bold tracking-[-0.08em]\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo text\">\n                        <span class=\"text-[#e50914]\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"logo X letter\">\n                            X\n                        </span>\n                        TREAM\n                    </span>\n                    <span class=\"h-6 w-px bg-[#333333]\" data-kid=\"1-1-1-1-1-2\" data-name=\"vertical separator line\">\n                    </span>\n                    <span class=\"text-xs font-medium text-[#a8a8a8]\" data-kid=\"1-1-1-1-1-3\" data-name=\"player application name\">\n                        المشغّل\n                    </span>\n                </a>\n                <nav aria-label=\"مسار النتائج\" class=\"hidden items-center gap-2 text-sm text-[#808080] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"breadcrumb navigation bar\">\n                    <span data-kid=\"1-1-1-1-2-1\" data-name=\"library breadcrumb item\">\n                        المكتبة\n                    </span>\n                    <i class=\"bi bi-chevron-left text-[10px]\" data-kid=\"1-1-1-1-2-2\" data-name=\"breadcrumb separator icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-1-2-3\" data-name=\"source breadcrumb item\">\n                        المصدر الحالي · Xtream\n                    </span>\n                    <i class=\"bi bi-chevron-left text-[10px]\" data-kid=\"1-1-1-1-2-4\" data-name=\"breadcrumb separator icon\">\n                    </i>\n                    <span class=\"text-[#ffffff]\" data-kid=\"1-1-1-1-2-5\" data-name=\"search results breadcrumb item\">\n                        نتائج البحث\n                    </span>\n                </nav>\n            </div>\n            <button class=\"inline-flex shrink-0 items-center gap-2 rounded-sm border border-[#333333] bg-transparent px-4 py-2.5 text-sm font-semibold text-[#ffffff]\" data-kid=\"1-1-1-2\" data-name=\"return to search button\" type=\"button\">\n                <i class=\"bi bi-arrow-right text-base text-[#a8a8a8]\" data-kid=\"1-1-1-2-1\" data-name=\"arrow right icon\">\n                </i>\n                العودة إلى نتائج المصدر\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1344px] px-8 pb-16 pt-7 max-[640px]:px-4 max-[640px]:pt-5\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-4 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"video meta information bar\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"live broadcast indicator container\">\n                <span class=\"flex h-8 w-8 items-center justify-center border border-[#333333] text-sm text-[#a8a8a8]\" data-kid=\"1-2-1-1-1\" data-name=\"broadcast icon wrapper\">\n                    <i class=\"bi bi-broadcast-pin\" data-kid=\"1-2-1-1-1-1\" data-name=\"broadcast icon\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"broadcast status text container\">\n                    <p class=\"m-0 text-sm font-semibold text-white\" data-kid=\"1-2-1-1-2-1\" data-name=\"live broadcast label\">\n                        بث مباشر\n                    </p>\n                    <p class=\"m-0 mt-0.5 text-xs text-[#808080]\" data-kid=\"1-2-1-1-2-2\" data-name=\"broadcast details text\">\n                        المصدر الحالي\n                        <span class=\"px-1 text-[#555555]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"separator dot\">\n                            ·\n                        </span>\n                        نتائج البحث\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2 text-xs text-[#808080]\" data-kid=\"1-2-1-2\" data-name=\"channel availability status\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#e50914]\" data-kid=\"1-2-1-2-1\" data-name=\"status online indicator dot\">\n                </span>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"channel source description\">\n                    القناة المختارة من المصدر\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"منطقة عرض الفيديو\" class=\"video-frame relative flex w-full items-center justify-center overflow-hidden border border-[#333333] bg-[#000000]\" data-kid=\"1-2-2\" data-name=\"video display section\" dir=\"ltr\">\n            <div class=\"absolute inset-x-0 top-0 flex items-center justify-between px-4 py-3 text-[11px] tracking-wide text-[#808080]\" data-kid=\"1-2-2-1\" data-name=\"video player overlay header\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1\" data-name=\"aspect ratio info container\">\n                    <i class=\"bi bi-display\" data-kid=\"1-2-2-1-1-1\" data-name=\"display icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-1-1-2\" data-name=\"aspect ratio value text\">\n                        16:9\n                    </span>\n                </span>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"play status warning message\">\n                    لا يوجد بث قيد التشغيل\n                </span>\n            </div>\n            <div class=\"mx-4 flex max-w-[440px] flex-col items-center text-center\" data-kid=\"1-2-2-2\" data-name=\"video error state container\" dir=\"rtl\">\n                <div class=\"mb-5 flex h-12 w-12 items-center justify-center border border-[#40151a] bg-[#14090b] text-xl text-[#e50914]\" data-kid=\"1-2-2-2-1\" data-name=\"error icon wrapper\">\n                    <i class=\"bi bi-exclamation-triangle\" data-kid=\"1-2-2-2-1-1\" data-name=\"exclamation triangle icon\">\n                    </i>\n                </div>\n                <h1 class=\"m-0 text-xl font-semibold tracking-[-0.02em] text-white max-[640px]:text-lg\" data-kid=\"1-2-2-2-2\" data-name=\"error title\">\n                    تعذر تحميل البث\n                </h1>\n                <p class=\"mb-0 mt-2 max-w-[340px] text-sm leading-6 text-[#a8a8a8]\" data-kid=\"1-2-2-2-3\" data-name=\"error description\">\n                    لم يبدأ العرض بعد. أعد المحاولة أو ارجع إلى نتائج المصدر لاختيار عنصر آخر.\n                </p>\n                <div class=\"mt-6 flex flex-wrap items-center justify-center gap-3\" data-kid=\"1-2-2-2-4\" data-name=\"error action buttons container\">\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-sm bg-[#e50914] px-5 py-2.5 text-sm font-bold text-white\" data-kid=\"1-2-2-2-4-1\" data-name=\"retry playback button\" type=\"button\">\n                        <i class=\"bi bi-arrow-clockwise\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"refresh icon\">\n                        </i>\n                        إعادة محاولة التشغيل\n                    </button>\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-sm border border-[#333333] bg-[#141414] px-4 py-2.5 text-sm font-semibold text-[#d8d8d8]\" data-kid=\"1-2-2-2-4-2\" data-name=\"return to search button\" type=\"button\">\n                        <i class=\"bi bi-arrow-right\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                        العودة إلى نتائج المصدر\n                    </button>\n                </div>\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 h-px bg-[#141414]\" data-kid=\"1-2-2-3\" data-name=\"video container bottom border\">\n            </div>\n        </section>\n        <section aria-label=\"تفاصيل المحتوى ودليل البرامج\" class=\"mt-6 grid grid-cols-[minmax(0,1fr)_320px] gap-10 max-[900px]:grid-cols-1 max-[900px]:gap-7\" data-kid=\"1-2-3\" data-name=\"content details and guide section\">\n            <div class=\"min-w-0\" data-kid=\"1-2-3-1\" data-name=\"content details column\">\n                <div class=\"flex flex-wrap items-start justify-between gap-5 border-b border-[#2f2f2f] pb-5\" data-kid=\"1-2-3-1-1\" data-name=\"channel title and retry action header\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-3-1-1-1\" data-name=\"channel identity container\">\n                        <h2 class=\"m-0 text-[25px] font-bold leading-tight tracking-[-0.03em] text-white max-[640px]:text-xl\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"channel name\">\n                            اسم القناة كما يرد من المصدر\n                        </h2>\n                        <div class=\"mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[#a8a8a8]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"channel metadata bar\">\n                            <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"broadcast metadata item\">\n                                <i class=\"bi bi-broadcast text-[#a8a8a8]\" data-kid=\"1-2-3-1-1-1-2-1-1\" data-name=\"broadcast icon\">\n                                </i>\n                                بث مباشر\n                            </span>\n                            <span class=\"text-[#555555]\" data-kid=\"1-2-3-1-1-1-2-2\" data-name=\"separator slash\">\n                                /\n                            </span>\n                            <span data-kid=\"1-2-3-1-1-1-2-3\" data-name=\"source label\">\n                                المصدر الحالي\n                            </span>\n                            <span class=\"text-[#555555]\" data-kid=\"1-2-3-1-1-1-2-4\" data-name=\"separator slash\">\n                                /\n                            </span>\n                            <span data-kid=\"1-2-3-1-1-1-2-5\" data-name=\"provider name\">\n                                Xtream\n                            </span>\n                        </div>\n                    </div>\n                    <button class=\"inline-flex min-h-10 shrink-0 items-center gap-2 border border-[#333333] px-3.5 py-2 text-sm font-medium text-[#d8d8d8]\" data-kid=\"1-2-3-1-1-2\" data-name=\"retry button\" type=\"button\">\n                        <i class=\"bi bi-arrow-clockwise text-[#a8a8a8]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"refresh icon\">\n                        </i>\n                        إعادة المحاولة\n                    </button>\n                </div>\n                <div class=\"mt-5 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-3-1-2\" data-name=\"channel program guide header\">\n                    <div data-kid=\"1-2-3-1-2-1\" data-name=\"program guide title container\">\n                        <h3 class=\"m-0 text-base font-semibold text-white\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"program guide title\">\n                            دليل البرامج\n                        </h3>\n                        <p class=\"mb-0 mt-1 text-xs text-[#808080]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"program guide description\">\n                            معلومات القناة تظهر هنا — لا تمنع بدء التشغيل.\n                        </p>\n                    </div>\n                    <span class=\"text-xs text-[#808080]\" data-kid=\"1-2-3-1-2-2\" data-name=\"guide availability status\">\n                        يُعرض عند توفر بيانات الدليل\n                    </span>\n                </div>\n                <div class=\"mt-4 flex min-h-[76px] items-center gap-3 border-t border-[#2f2f2f] py-4 text-sm text-[#a8a8a8]\" data-kid=\"1-2-3-1-3\" data-name=\"program guide content display\">\n                    <i class=\"bi bi-calendar2-week text-lg text-[#808080]\" data-kid=\"1-2-3-1-3-1\" data-name=\"calendar icon\">\n                    </i>\n                    <p class=\"m-0\" data-kid=\"1-2-3-1-3-2\" data-name=\"empty guide state message\">\n                        لا تتوفر بيانات دليل البرامج لهذه القناة حاليًا.\n                    </p>\n                </div>\n            </div>\n            <aside aria-label=\"سياق البحث\" class=\"border-r border-[#2f2f2f] pr-7 max-[900px]:border-r-0 max-[900px]:border-t max-[900px]:pr-0 max-[900px]:pt-6\" data-kid=\"1-2-3-2\" data-name=\"sidebar context menu\">\n                <p class=\"mb-3 mt-0 text-xs font-semibold text-[#808080]\" data-kid=\"1-2-3-2-1\" data-name=\"source context title\">\n                    سياق المصدر\n                </p>\n                <div class=\"flex items-center justify-between gap-3 border-b border-[#2f2f2f] py-3\" data-kid=\"1-2-3-2-2\" data-name=\"source name row\">\n                    <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-2-3-2-2-1\" data-name=\"source label\">\n                        المصدر\n                    </span>\n                    <span class=\"text-sm font-medium text-white\" data-kid=\"1-2-3-2-2-2\" data-name=\"source name\">\n                        Xtream\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between gap-3 border-b border-[#2f2f2f] py-3\" data-kid=\"1-2-3-2-3\" data-name=\"content type row\">\n                    <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-2-3-2-3-1\" data-name=\"content type label\">\n                        نوع المحتوى\n                    </span>\n                    <span class=\"text-sm font-medium text-white\" data-kid=\"1-2-3-2-3-2\" data-name=\"content type value\">\n                        قناة مباشرة\n                    </span>\n                </div>\n                <div class=\"mt-5\" data-kid=\"1-2-3-2-4\" data-name=\"back to browsing container\">\n                    <p class=\"mb-2 mt-0 text-xs text-[#808080]\" data-kid=\"1-2-3-2-4-1\" data-name=\"back to browsing title\">\n                        العودة إلى موضع التصفح\n                    </p>\n                    <button class=\"flex w-full items-center justify-between gap-3 py-2 text-right text-sm font-semibold text-white\" data-kid=\"1-2-3-2-4-2\" data-name=\"back to browsing button\" type=\"button\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"search icon\">\n                            <i class=\"bi bi-search text-[#a8a8a8]\" data-kid=\"1-2-3-2-4-2-1-1\">\n                            </i>\n                            نتائج البحث في المصدر الحالي\n                        </span>\n                        <i class=\"bi bi-arrow-left text-[#a8a8a8]\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"arrow left icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mt-6 border-t border-[#2f2f2f] pt-4\" data-kid=\"1-2-3-2-5\" data-name=\"sidebar footer note\">\n                    <p class=\"m-0 text-xs leading-5 text-[#808080]\" data-kid=\"1-2-3-2-5-1\" data-name=\"sidebar footer text\">\n                        تظهر خيارات الفيلم أو قائمة مواسم المسلسل بحسب نوع العنصر الذي فتحته من النتائج.\n                    </p>\n                </div>\n            </aside>\n        </section>\n    </main>\n</div>\n",
