      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n@layer components {\n  .xtream-library { font-family: 'Noto Sans Arabic', Inter, sans-serif; background: #000; color: #fff; }\n  .xtream-wrap { width: min(100% - 64px, 1344px); margin-inline: auto; }\n  .xtream-nav-link { color: #a8a8a8; text-decoration: none; transition: color .18s ease; }\n  .xtream-nav-link:hover { color: #fff; }\n  .xtream-control { background: #141414; border: 1px solid #333; color: #fff; }\n  .xtream-control:focus { outline: 2px solid #e50914; outline-offset: 2px; }\n  .xtream-section-line { border-color: #2a2a2a; }\n  .xtream-play { background: #e50914; color: #fff; transition: background .18s ease; }\n  .xtream-play:hover { background: #b20710; }\n  .xtream-subtle { color: #a8a8a8; }\n  @media (max-width: 760px) {\n    .xtream-wrap { width: min(100% - 32px, 1344px); }\n    .xtream-header-inner { flex-wrap: wrap; gap: 12px; padding-block: 14px; }\n    .xtream-header-links { order: 3; width: 100%; justify-content: space-between; }\n    .xtream-toolbar { align-items: stretch; flex-direction: column; }\n    .xtream-filter-row { display: grid; grid-template-columns: 1fr; }\n    .xtream-feature-layout { grid-template-columns: 1fr; }\n    .xtream-feature-main { padding: 20px; }\n    .xtream-live-panel { padding: 24px 0 0; }\n    .xtream-poster { width: min(100%, 250px); height: auto; }\n  }\n</style>\n<div class=\"xtream-library min-h-screen bg-black text-white\" data-kid=\"1\" dir=\"rtl\" lang=\"ar\">\n    <header class=\"border-b border-[#252525] bg-black\" data-kid=\"1-1\">\n        <div class=\"xtream-wrap xtream-header-inner flex min-h-[76px] items-center gap-10\" data-kid=\"1-1-1\">\n            <a aria-label=\"Xtream\" class=\"flex shrink-0 items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"grid size-10 place-items-center rounded-md bg-[#e50914] text-xl text-white\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"bi bi-play-fill\" data-kid=\"1-1-1-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"text-[19px] font-bold tracking-[.04em] text-white\" data-kid=\"1-1-1-1-2\">\n                    XTREAM\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"xtream-header-links flex items-center gap-7 text-[14px]\" data-kid=\"1-1-1-2\">\n                <a aria-current=\"page\" class=\"text-white no-underline\" data-kid=\"1-1-1-2-1\" href=\"#library\">\n                    المكتبة\n                </a>\n                <a class=\"xtream-nav-link\" data-kid=\"1-1-1-2-2\" href=\"#subscription\">\n                    الاشتراكات\n                </a>\n            </nav>\n            <div class=\"ms-auto flex items-center gap-4\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"البحث\" class=\"grid size-10 place-items-center rounded-full text-lg text-[#a8a8a8] hover:bg-[#181818] hover:text-white\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"bi bi-search\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                </button>\n                <button aria-label=\"الحساب الشخصي\" class=\"flex items-center gap-2 rounded-full border border-[#333] px-3 py-2 text-sm text-white hover:border-[#666]\" data-kid=\"1-1-1-3-2\">\n                    <i class=\"bi bi-person-circle text-lg text-[#a8a8a8]\" data-kid=\"1-1-1-3-2-1\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\">\n                        حسابي\n                    </span>\n                    <i class=\"bi bi-chevron-down text-[10px] text-[#808080]\" data-kid=\"1-1-1-3-2-3\">\n                    </i>\n                </button>\n                <button aria-label=\"تغيير اللغة\" class=\"rounded border border-[#333] px-2.5 py-1.5 text-xs font-semibold text-[#c9c9c9] hover:border-[#666]\" data-kid=\"1-1-1-3-3\">\n                    عربي\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"xtream-wrap pb-16 pt-8\" data-kid=\"1-2\" id=\"library\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"mb-2 text-[32px] font-bold leading-tight tracking-[-.025em]\" data-kid=\"1-2-1-1-1\">\n                    اختر ما تريد مشاهدته\n                </h1>\n                <p class=\"xtream-subtle m-0 text-sm\" data-kid=\"1-2-1-1-2\">\n                    تصفّح حسب نوع المحتوى أو ابحث في المصدر المحدد.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\">\n                <label class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-2-1-2-1\" for=\"source\">\n                    المصدر\n                </label>\n                <div class=\"relative\" data-kid=\"1-2-1-2-2\">\n                    <select class=\"xtream-control min-w-[190px] appearance-none rounded-md py-2.5 pe-10 ps-3 text-sm\" data-kid=\"1-2-1-2-2-1\" id=\"source\">\n                        <option data-kid=\"1-2-1-2-2-1-1\">\n                            Xtream\n                        </option>\n                        <option data-kid=\"1-2-1-2-2-1-2\">\n                            M3U / M3U8\n                        </option>\n                    </select>\n                    <i class=\"bi bi-chevron-down pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-1-2-2-2\">\n                    </i>\n                </div>\n                <button class=\"rounded-md border border-[#3a3a3a] px-4 py-2.5 text-sm font-medium text-white hover:border-[#777]\" data-kid=\"1-2-1-2-3\">\n                    إضافة مصدر\n                </button>\n            </div>\n        </div>\n        <div class=\"mb-5 flex flex-wrap items-center justify-between gap-5 border-b xtream-section-line\" data-kid=\"1-2-2\">\n            <nav aria-label=\"أنواع المحتوى\" class=\"flex items-center gap-8\" data-kid=\"1-2-2-1\">\n                <a class=\"xtream-nav-link py-3.5 text-[15px]\" data-kid=\"1-2-2-1-1\" href=\"#live\">\n                    البث المباشر\n                </a>\n                <a class=\"xtream-nav-link py-3.5 text-[15px]\" data-kid=\"1-2-2-1-2\" href=\"#movies\">\n                    الأفلام\n                </a>\n                <a aria-current=\"page\" class=\"relative py-3.5 text-[15px] font-semibold text-white no-underline\" data-kid=\"1-2-2-1-3\" href=\"#series\">\n                    المسلسلات\n                    <span class=\"absolute inset-x-0 bottom-0 h-[3px] rounded-t bg-[#e50914]\" data-kid=\"1-2-2-1-3-1\">\n                    </span>\n                </a>\n            </nav>\n            <span class=\"pb-3 text-xs text-[#808080]\" data-kid=\"1-2-2-2\">\n                يعرض المصدر المحدد فقط\n            </span>\n        </div>\n        <div class=\"xtream-filter-row mb-9 grid grid-cols-[minmax(0,1fr)_235px] gap-3\" data-kid=\"1-2-3\">\n            <div data-kid=\"1-2-3-1\">\n                <label class=\"mb-2 block text-xs font-medium text-[#bdbdbd]\" data-kid=\"1-2-3-1-1\" for=\"catalog-search\">\n                    ابحث في المسلسلات\n                </label>\n                <div class=\"relative\" data-kid=\"1-2-3-1-2\">\n                    <i class=\"bi bi-search absolute right-4 top-1/2 -translate-y-1/2 text-[#808080]\" data-kid=\"1-2-3-1-2-1\">\n                    </i>\n                    <input class=\"xtream-control w-full rounded-md py-3 pe-11 ps-4 text-sm placeholder:text-[#707070]\" data-kid=\"1-2-3-1-2-2\" id=\"catalog-search\" placeholder=\"اكتب اسم العمل\" type=\"search\"/>\n                </div>\n            </div>\n            <div data-kid=\"1-2-3-2\">\n                <label class=\"mb-2 block text-xs font-medium text-[#bdbdbd]\" data-kid=\"1-2-3-2-1\" for=\"category\">\n                    الفئة\n                </label>\n                <div class=\"relative\" data-kid=\"1-2-3-2-2\">\n                    <select class=\"xtream-control w-full appearance-none rounded-md py-3 pe-3 ps-10 text-sm\" data-kid=\"1-2-3-2-2-1\" id=\"category\">\n                        <option data-kid=\"1-2-3-2-2-1-1\">\n                            جميع الفئات\n                        </option>\n                    </select>\n                    <i class=\"bi bi-chevron-down pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-3-2-2-2\">\n                    </i>\n                </div>\n            </div>\n        </div>\n        <section aria-labelledby=\"series-heading\" class=\"mb-12\" data-kid=\"1-2-4\" id=\"series\">\n            <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-4-1\">\n                <h2 class=\"m-0 text-[21px] font-bold tracking-[-.01em]\" data-kid=\"1-2-4-1-1\" id=\"series-heading\">\n                    مسلسلات\n                </h2>\n                <span class=\"text-xs text-[#777]\" data-kid=\"1-2-4-1-2\">\n                    من المصدر الحالي\n                </span>\n            </div>\n            <div class=\"xtream-feature-layout grid grid-cols-[minmax(210px,250px)_minmax(0,1fr)] items-center gap-12 border-y border-[#292929] py-6\" data-kid=\"1-2-4-2\" data-name=\"series and live panel container\">\n                <article class=\"min-w-0\" data-kid=\"1-2-4-2-1\" data-name=\"series display column\">\n                    <figure class=\"m-0 overflow-hidden bg-[#141414]\" data-kid=\"1-2-4-2-1-1\" data-name=\"series poster wrapper\">\n                        <img alt=\"ملصق مسلسل محفوظ في مكتبة المشروع\" class=\"xtream-poster block h-[375px] w-full object-cover object-center\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"series poster image\" data-reason=\"src replaced by script when library content loads\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/series/163873cd62df416de16bb5f1bd66f6e5.jpg\"/>\n                    </figure>\n                    <div class=\"pt-4\" data-kid=\"1-2-4-2-1-2\" data-name=\"series info block\">\n                        <p class=\"mb-1 text-xs font-medium text-[#8f8f8f]\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"series label text\">\n                            مسلسل\n                        </p>\n                        <h3 class=\"mb-4 text-lg font-bold leading-snug\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"series title text\" data-reason=\"text replaced by script when library content loads\">\n                            عنوان العمل\n                        </h3>\n                        <button class=\"xtream-play inline-flex min-h-11 items-center gap-2 rounded px-4 py-2.5 text-sm font-bold\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"series episodes button\">\n                            <i class=\"bi bi-collection-play-fill\" data-kid=\"1-2-4-2-1-2-3-1\" data-name=\"series collection play icon\">\n                            </i>\n                            <span data-kid=\"1-2-4-2-1-2-3-2\" data-name=\"series episodes text\">\n                                استعراض الحلقات\n                            </span>\n                        </button>\n                    </div>\n                </article>\n                <section aria-labelledby=\"live-heading\" class=\"xtream-live-panel self-stretch border-r border-[#292929] pe-10\" data-kid=\"1-2-4-2-2\" data-name=\"live channels panel\" id=\"live\">\n                    <div class=\"flex h-full max-w-[700px] flex-col justify-center\" data-kid=\"1-2-4-2-2-1\" data-name=\"live channels inner content\">\n                        <h2 class=\"mb-2 text-xl font-bold\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"live section heading\" id=\"live-heading\">\n                            البث المباشر\n                        </h2>\n                        <p class=\"mb-7 text-sm leading-6 text-[#a8a8a8]\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"live section description\">\n                            تصفّح القنوات من المصدر المحدد.\n                        </p>\n                        <div class=\"flex flex-wrap items-center justify-between gap-5 border-y border-[#292929] py-5\" data-kid=\"1-2-4-2-2-1-3\" data-name=\"live channel row\">\n                            <div class=\"flex items-center gap-4\" data-kid=\"1-2-4-2-2-1-3-1\" data-name=\"live channel info\">\n                                <div class=\"grid h-[58px] w-[104px] shrink-0 place-items-center overflow-hidden rounded bg-white p-1\" data-kid=\"1-2-4-2-2-1-3-1-1\" data-name=\"live channel logo wrapper\">\n                                    <img alt=\"شعار beIN SPORTS 4K\" class=\"max-h-full max-w-full object-contain\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-3-1-1-1\" data-name=\"live channel logo image\" data-reason=\"src replaced by script when library content loads\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/live/9393d33bfc62c6e0a42367ea4baf12b7.png\"/>\n                                </div>\n                                <span class=\"text-sm text-[#bdbdbd]\" data-kid=\"1-2-4-2-2-1-3-1-2\" data-name=\"live channel source indicator\">\n                                    من المصدر الحالي\n                                </span>\n                            </div>\n                            <button class=\"inline-flex min-h-10 items-center gap-2 rounded border border-[#484848] px-4 py-2 text-sm font-semibold text-white hover:border-[#888]\" data-kid=\"1-2-4-2-2-1-3-2\" data-name=\"play channel button\">\n                                <i class=\"bi bi-play-fill text-lg text-[#e50914]\" data-kid=\"1-2-4-2-2-1-3-2-1\" data-name=\"play icon\">\n                                </i>\n                                <span data-kid=\"1-2-4-2-2-1-3-2-2\" data-name=\"play channel text\">\n                                    تشغيل القناة\n                                </span>\n                            </button>\n                        </div>\n                        <a class=\"mt-5 self-start text-sm text-[#bdbdbd] underline decoration-[#555] underline-offset-4 hover:text-white\" data-kid=\"1-2-4-2-2-1-4\" data-name=\"view all channels link\" href=\"#live\">\n                            عرض القنوات\n                        </a>\n                    </div>\n                </section>\n            </div>\n        </section>\n        <footer class=\"mt-14 border-t border-[#202020] pt-5 text-xs text-[#747474]\" data-kid=\"1-2-5\" data-name=\"footer bar\">\n            <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-5-1\" data-name=\"footer inner container\">\n                <span data-kid=\"1-2-5-1-1\" data-name=\"footer site name\">\n                    Xtream · مكتبتك للمشاهدة\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-2-5-1-2\" data-name=\"current source status text\" data-reason=\"text replaced by script when source selection changes\">\n                    المصدر المحدد: Xtream\n                </span>\n            </div>\n        </footer>\n    </main>\n</div>\n",
