      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n@import url(\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap\");\n.arabic-ui { font-family: 'IBM Plex Sans Arabic', 'Inter', sans-serif; }\n</style>\n<div class=\"arabic-ui min-h-screen bg-[#000000] text-white\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"border-b border-[#242424] bg-[#050505]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1360px] items-center gap-8 px-8\" data-kid=\"1-1-1\" data-name=\"header navigation inner container\">\n            <a class=\"flex shrink-0 items-center gap-3 text-white no-underline\" data-kid=\"1-1-1-1\" data-name=\"logo anchor link\" href=\"#\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-[8px] bg-[#e50914] text-xl font-bold leading-none\" data-kid=\"1-1-1-1-1\" data-name=\"logo icon container\">\n                    X\n                </span>\n                <span class=\"text-[15px] font-bold tracking-[0.12em]\" data-kid=\"1-1-1-1-2\" data-name=\"logo text\">\n                    XTREAM\n                    <span class=\"font-normal tracking-normal text-[#a8a8a8]\" data-kid=\"1-1-1-1-2-1\" data-name=\"logo subtext\">\n                        PLAYER\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden flex-1 items-center gap-8 text-[14px] text-[#a8a8a8] md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"text-white no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"navigation home link\" href=\"#\">\n                    الرئيسية\n                </a>\n                <a class=\"no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"navigation live stream link\" href=\"#\">\n                    بث مباشر\n                </a>\n                <a class=\"no-underline\" data-kid=\"1-1-1-2-3\" data-name=\"navigation movie link\" href=\"#\">\n                    أفلام\n                </a>\n                <a class=\"no-underline\" data-kid=\"1-1-1-2-4\" data-name=\"navigation series link\" href=\"#\">\n                    مسلسلات\n                </a>\n            </nav>\n            <div class=\"mr-auto flex items-center gap-4\" data-kid=\"1-1-1-3\" data-name=\"user actions container\">\n                <button aria-label=\"اللغة العربية\" class=\"flex items-center gap-2 rounded-[6px] border border-[#333333] px-3 py-2 text-[12px] font-medium text-[#a8a8a8]\" data-kid=\"1-1-1-3-1\" data-name=\"language selection dropdown button\">\n                    <span data-kid=\"1-1-1-3-1-1\" data-name=\"language abbreviation text\">\n                        ع\n                    </span>\n                    <span data-kid=\"1-1-1-3-1-2\" data-name=\"language name text\">\n                        العربية\n                    </span>\n                    <i class=\"bi bi-chevron-down text-[10px]\" data-kid=\"1-1-1-3-1-3\" data-name=\"language dropdown icon\">\n                    </i>\n                </button>\n                <button aria-label=\"الحساب\" class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#181818] text-lg text-[#d0d0d0]\" data-kid=\"1-1-1-3-2\" data-name=\"user account button\">\n                    <i class=\"bi bi-person\" data-kid=\"1-1-1-3-2-1\" data-name=\"user profile icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1360px] px-8 pb-16 pt-7\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-6 flex items-center justify-between gap-5\" data-kid=\"1-2-1\" data-name=\"breadcrumb and back navigation container\">\n            <div class=\"flex items-center gap-2 text-[13px] text-[#808080]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb path container\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb library link\">\n                    المكتبة\n                </span>\n                <i class=\"bi bi-chevron-left text-[10px]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator icon\">\n                </i>\n                <span data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb series link\">\n                    المسلسلات\n                </span>\n                <i class=\"bi bi-chevron-left text-[10px]\" data-kid=\"1-2-1-1-4\" data-name=\"breadcrumb separator icon\">\n                </i>\n                <span class=\"text-[#d4d4d4]\" data-kid=\"1-2-1-1-5\" data-name=\"breadcrumb current page title\">\n                    اسم العمل\n                </span>\n            </div>\n            <a class=\"flex items-center gap-2 text-[13px] text-[#a8a8a8] no-underline\" data-kid=\"1-2-1-2\" data-name=\"back to series navigation link\" href=\"#\">\n                <i class=\"bi bi-arrow-right\" data-kid=\"1-2-1-2-1\" data-name=\"back navigation icon\">\n                </i>\n                العودة إلى المسلسلات\n            </a>\n        </div>\n        <div class=\"grid grid-cols-1 items-start gap-7 xl:grid-cols-[minmax(0,1fr)_344px]\" data-kid=\"1-2-2\" data-name=\"video and info layout grid\">\n            <section class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"video section\">\n                <div class=\"relative aspect-video w-full overflow-hidden rounded-[8px] border border-[#252525] bg-[#030303]\" data-kid=\"1-2-2-1-1\" data-name=\"video player placeholder container\">\n                    <span class=\"absolute left-4 top-4 rounded-[4px] bg-[#141414] px-2.5 py-1.5 text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-1-1\" data-name=\"static preview label\">\n                        معاينة ثابتة\n                    </span>\n                    <div class=\"absolute inset-0 flex flex-col items-center justify-center gap-4 text-center\" data-kid=\"1-2-2-1-1-2\" data-name=\"player overlay controls\">\n                        <span aria-hidden=\"true\" class=\"flex h-[68px] w-[68px] items-center justify-center rounded-full border border-[#383838] bg-[#111111] text-[30px] text-[#d7d7d7]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"video play button\">\n                            <i class=\"bi bi-play-fill mr-[-3px]\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"play icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-2-1-1-2-2\" data-name=\"player instructional text\">\n                            <p class=\"mb-1 text-[15px] font-semibold text-white\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"player start playback text\">\n                                واجهة المشغّل\n                            </p>\n                            <p class=\"m-0 text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"player status text\">\n                                لا يوجد فيديو فعلي أو مؤشر تقدم في هذه المعاينة\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-0 right-0 left-0 flex items-center justify-between bg-gradient-to-t from-black via-black/80 to-transparent px-5 pb-4 pt-12\" data-kid=\"1-2-2-1-1-3\" data-name=\"player bottom control bar\">\n                        <div class=\"flex items-center gap-5 text-[18px] text-[#e5e5e5]\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"player playback controls\">\n                            <button aria-label=\"تشغيل\" class=\"flex items-center\" data-kid=\"1-2-2-1-1-3-1-1\" data-name=\"play/pause button\">\n                                <i class=\"bi bi-play-fill\" data-kid=\"1-2-2-1-1-3-1-1-1\" data-name=\"play icon\">\n                                </i>\n                            </button>\n                            <button aria-label=\"الصوت\" class=\"flex items-center text-[16px]\" data-kid=\"1-2-2-1-1-3-1-2\" data-name=\"volume control button\">\n                                <i class=\"bi bi-volume-up\" data-kid=\"1-2-2-1-1-3-1-2-1\" data-name=\"volume icon\">\n                                </i>\n                            </button>\n                            <span class=\"text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-1-3-1-3\" data-name=\"video title text\">\n                                اسم العمل\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-5 text-[16px] text-[#e5e5e5]\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"player secondary controls\">\n                            <button aria-label=\"الترجمة\" data-kid=\"1-2-2-1-1-3-2-1\" data-name=\"closed captioning button\">\n                                <i class=\"bi bi-badge-cc\" data-kid=\"1-2-2-1-1-3-2-1-1\" data-name=\"cc icon\">\n                                </i>\n                            </button>\n                            <button aria-label=\"ملء الشاشة\" data-kid=\"1-2-2-1-1-3-2-2\" data-name=\"fullscreen toggle button\">\n                                <i class=\"bi bi-arrows-fullscreen\" data-kid=\"1-2-2-1-1-3-2-2-1\" data-name=\"fullscreen icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex flex-col justify-between gap-5 border-b border-[#282828] pb-5 sm:flex-row sm:items-center\" data-kid=\"1-2-2-1-2\" data-name=\"series header info container\">\n                    <div class=\"flex items-center gap-5\" data-kid=\"1-2-2-1-2-1\" data-name=\"series meta container\">\n                        <img alt=\"ملصق مسلسل من المصدر المحلي\" class=\"h-[112px] w-[76px] shrink-0 rounded-[4px] object-cover\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"series poster image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/series/163873cd62df416de16bb5f1bd66f6e5.jpg\"/>\n                        <div data-kid=\"1-2-2-1-2-1-2\" data-name=\"series details text container\">\n                            <h1 class=\"mb-2 text-[27px] font-bold leading-tight text-white\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"series title heading\">\n                                اسم العمل\n                            </h1>\n                            <div class=\"flex items-center gap-2 text-[13px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"series type tag\">\n                                <i class=\"bi bi-collection-play text-[15px]\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"series collection icon\">\n                                </i>\n                                <span data-kid=\"1-2-2-1-2-1-2-2-2\" data-name=\"series type text\">\n                                    مسلسل\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-2\" data-name=\"episodes list link container\">\n                        <span class=\"text-[12px] text-[#808080]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"episodes list link text\">\n                            قائمة الحلقات\n                        </span>\n                        <i class=\"bi bi-arrow-left text-[14px] text-[#808080]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"episodes list link icon\">\n                        </i>\n                    </div>\n                </div>\n                <section aria-labelledby=\"epg-title\" class=\"pt-6\" data-kid=\"1-2-2-1-3\" data-name=\"electronic program guide section\">\n                    <h2 class=\"mb-4 text-[17px] font-semibold text-white\" data-kid=\"1-2-2-1-3-1\" data-name=\"epg section heading\" id=\"epg-title\">\n                        دليل البرامج\n                    </h2>\n                    <div class=\"flex min-h-[78px] items-center gap-3 border-y border-[#222222] py-5 text-[14px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-3-2\" data-name=\"epg empty state container\">\n                        <i class=\"bi bi-calendar2-week text-[17px] text-[#e50914]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"epg calendar icon\">\n                        </i>\n                        <p class=\"m-0\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"epg empty state text\">\n                            لا تتوفر بيانات دليل البرامج لهذا المصدر\n                        </p>\n                    </div>\n                </section>\n                <section aria-labelledby=\"movie-download-title\" class=\"mt-8 border-t border-[#242424] pt-6\" data-kid=\"1-2-2-1-4\" data-name=\"movie download section\">\n                    <div class=\"mb-4 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-2-2-1-4-1\" data-name=\"download header container\">\n                        <div data-kid=\"1-2-2-1-4-1-1\" data-name=\"download description container\">\n                            <h2 class=\"mb-1 text-[17px] font-semibold text-white\" data-kid=\"1-2-2-1-4-1-1-1\" data-name=\"download section title\" id=\"movie-download-title\">\n                                تنزيل الفيلم\n                            </h2>\n                            <p class=\"m-0 text-[12px] text-[#808080]\" data-kid=\"1-2-2-1-4-1-1-2\" data-name=\"download disclaimer text\">\n                                يظهر هذا الإجراء بجانب تفاصيل الفيلم للمشترك المدفوع فقط.\n                            </p>\n                        </div>\n                        <button aria-label=\"تنزيل الفيلم للمشترك المدفوع\" class=\"flex items-center gap-2 rounded-[5px] border border-[#474747] px-4 py-2.5 text-[13px] font-semibold text-[#e2e2e2]\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"locked download action button\">\n                            <i class=\"bi bi-lock-fill text-[12px]\" data-kid=\"1-2-2-1-4-1-2-1\" data-name=\"lock icon\">\n                            </i>\n                            تنزيل الفيلم\n                        </button>\n                    </div>\n                    <div aria-label=\"معاينة حوار اختيار جودة التنزيل للفيلم\" class=\"max-w-[580px] rounded-[8px] bg-[#141414] p-5\" data-kid=\"1-2-2-1-4-2\" data-name=\"download quality modal dialog\" role=\"dialog\">\n                        <div class=\"mb-4 flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"modal header\">\n                            <div data-kid=\"1-2-2-1-4-2-1-1\" data-name=\"modal title container\">\n                                <h3 class=\"mb-1 text-[15px] font-semibold text-white\" data-kid=\"1-2-2-1-4-2-1-1-1\" data-name=\"modal title heading\">\n                                    اختيار جودة التنزيل\n                                </h3>\n                                <p class=\"m-0 text-[12px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-1-1-2\" data-name=\"modal description text\">\n                                    معاينة الحوار · للفيلم عند توفر الاشتراك\n                                </p>\n                            </div>\n                            <button aria-label=\"إغلاق\" class=\"text-[16px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-4-2-1-2\" data-name=\"modal close button\">\n                                <i class=\"bi bi-x-lg\" data-kid=\"1-2-2-1-4-2-1-2-1\" data-name=\"close icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-5\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"quality options grid\">\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-1\" data-name=\"4k quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-1-1\" data-name=\"4k quality text\">\n                                    Ultra HD 4K\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-1-1-1\" data-name=\"4k resolution text\">\n                                        (2160p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-1-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-2\" data-name=\"2k quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-2-1\" data-name=\"2k quality text\">\n                                    Quad HD 2K\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-2-1-1\" data-name=\"2k resolution text\">\n                                        (1440p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-2-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-3\" data-name=\"1080p quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-3-1\" data-name=\"1080p quality text\">\n                                    Full HD\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-3-1-1\" data-name=\"1080p resolution text\">\n                                        (1080p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-3-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-4\" data-name=\"720p quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-4-1\" data-name=\"720p quality text\">\n                                    HD\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-4-1-1\" data-name=\"720p resolution text\">\n                                        (720p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-4-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-5\" data-name=\"480p quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-5-1\" data-name=\"480p quality text\">\n                                    قياسي\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-5-1-1\" data-name=\"480p resolution text\">\n                                        (480p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-5-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-6\" data-name=\"360p quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-6-1\" data-name=\"360p quality text\">\n                                    متوسط\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-6-1-1\" data-name=\"360p resolution text\">\n                                        (360p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-6-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"col-span-2 flex items-center justify-between border-b border-[#2b2b2b] py-3 text-right text-[13px] text-[#efefef]\" data-kid=\"1-2-2-1-4-2-2-7\" data-name=\"240p quality option button\">\n                                <span data-kid=\"1-2-2-1-4-2-2-7-1\" data-name=\"240p quality text\">\n                                    جودة منخفضة للهاتف\n                                    <span class=\"text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-7-1-1\" data-name=\"240p resolution text\">\n                                        (240p)\n                                    </span>\n                                </span>\n                                <i class=\"bi bi-chevron-left text-[10px] text-[#808080]\" data-kid=\"1-2-2-1-4-2-2-7-2\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-4 flex justify-end\" data-kid=\"1-2-2-1-4-2-3\" data-name=\"modal footer\">\n                            <button class=\"rounded-[5px] px-4 py-2 text-[12px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-2-1-4-2-3-1\" data-name=\"cancel button\">\n                                إلغاء\n                            </button>\n                        </div>\n                    </div>\n                </section>\n            </section>\n            <aside aria-labelledby=\"episodes-title\" class=\"min-w-0 xl:pt-1\" data-kid=\"1-2-2-2\" data-name=\"episodes sidebar\">\n                <div class=\"flex items-center justify-between border-b border-[#282828] pb-4\" data-kid=\"1-2-2-2-1\" data-name=\"sidebar header container\">\n                    <h2 class=\"m-0 text-[18px] font-semibold text-white\" data-kid=\"1-2-2-2-1-1\" data-name=\"sidebar heading\" id=\"episodes-title\">\n                        قائمة الحلقات\n                    </h2>\n                    <i class=\"bi bi-collection-play text-[18px] text-[#a8a8a8]\" data-kid=\"1-2-2-2-1-2\" data-name=\"sidebar icon\">\n                    </i>\n                </div>\n                <div class=\"flex min-h-[220px] flex-col items-center justify-center border-b border-[#282828] px-5 py-8 text-center\" data-kid=\"1-2-2-2-2\" data-name=\"empty episodes container\">\n                    <span class=\"mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#141414] text-xl text-[#808080]\" data-kid=\"1-2-2-2-2-1\" data-name=\"empty state icon wrapper\">\n                        <i class=\"bi bi-list-ul\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"empty state icon\">\n                        </i>\n                    </span>\n                    <p class=\"mb-1 text-[14px] font-medium text-[#d0d0d0]\" data-kid=\"1-2-2-2-2-2\" data-name=\"empty state heading\">\n                        لا تتوفر بيانات الحلقات لهذا المصدر\n                    </p>\n                    <p class=\"m-0 text-[12px] text-[#808080]\" data-kid=\"1-2-2-2-2-3\" data-name=\"empty state description text\">\n                        لن تظهر مواسم أو أرقام حلقات حتى يرسلها المصدر.\n                    </p>\n                </div>\n                <div class=\"pt-7\" data-kid=\"1-2-2-2-3\" data-name=\"sidebar additional info container\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-2-2-3-1\" data-name=\"additional info header\">\n                        <h3 class=\"m-0 text-[15px] font-semibold text-white\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"additional info title\">\n                            معلومات الحلقة\n                        </h3>\n                        <span class=\"text-[11px] text-[#808080]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"data source notice text\">\n                            حسب بيانات المصدر\n                        </span>\n                    </div>\n                    <div class=\"flex items-start gap-3 border-b border-[#242424] py-3 text-[13px] text-[#a8a8a8]\" data-kid=\"1-2-2-2-3-2\" data-name=\"info item container\">\n                        <i class=\"bi bi-info-circle mt-0.5 text-[14px] text-[#808080]\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"info icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-3-2-2\" data-name=\"info text\">\n                            تظهر تفاصيل الحلقة عند توفرها.\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-7 border-t border-[#2a2a2a] pt-5\" data-kid=\"1-2-2-2-4\" data-name=\"download info footer\">\n                    <p class=\"mb-2 text-[12px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-2-2-4-1\" data-name=\"footer heading\">\n                        للفيلم فقط\n                    </p>\n                    <p class=\"mb-3 text-[12px] leading-6 text-[#808080]\" data-kid=\"1-2-2-2-4-2\" data-name=\"footer description text\">\n                        يظهر زر التنزيل قرب بيانات الفيلم، ويُتاح للمشتركين المدفوعين.\n                    </p>\n                    <div class=\"flex items-center gap-2 text-[11px] text-[#808080]\" data-kid=\"1-2-2-2-4-3\" data-name=\"subscription requirement container\">\n                        <i class=\"bi bi-lock-fill text-[12px]\" data-kid=\"1-2-2-2-4-3-1\" data-name=\"lock icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-4-3-2\" data-name=\"subscription requirement text\">\n                            يتطلب اشتراكًا مدفوعًا\n                        </span>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
