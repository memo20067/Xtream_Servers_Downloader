      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-black text-white\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" style=\"font-family: Inter, system-ui, sans-serif;\">\n    <div class=\"grid min-h-screen grid-cols-1 lg:grid-cols-[264px_minmax(0,1fr)]\" data-kid=\"1-1\" data-name=\"grid layout wrapper\">\n        <aside class=\"hidden border-e border-[#333] bg-[#0b0b0b] px-5 py-7 lg:flex lg:flex-col\" data-kid=\"1-1-1\" data-name=\"sidebar navigation container\">\n            <div class=\"mb-10 flex items-center gap-3 px-2\" data-kid=\"1-1-1-1\" data-name=\"logo and brand container\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-[#181818] text-lg font-bold text-[#e50914]\" data-kid=\"1-1-1-1-1\" data-name=\"logo placeholder icon\">\n                    X\n                </span>\n                <span class=\"text-[21px] font-bold tracking-[-0.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Xtream\n                </span>\n            </div>\n            <nav aria-label=\"التنقل الإداري\" class=\"flex flex-1 flex-col gap-7\" data-kid=\"1-1-1-2\" data-name=\"sidebar navigation links container\">\n                <div data-kid=\"1-1-1-2-1\" data-name=\"main navigation group\">\n                    <p class=\"mb-2 px-3 text-xs font-medium text-[#808080]\" data-kid=\"1-1-1-2-1-1\" data-name=\"navigation group label\">\n                        الرئيسية\n                    </p>\n                    <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-1-2\" data-name=\"dashboard navigation button\" dir=\"ltr\" type=\"button\">\n                        <i class=\"bi bi-grid-1x2 h-4 w-4 text-base\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"dashboard icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-1-2-2\" data-name=\"dashboard label\">\n                            Dashboard\n                        </span>\n                    </button>\n                </div>\n                <div data-kid=\"1-1-1-2-2\" data-name=\"access and subscriptions group\">\n                    <p class=\"mb-2 px-3 text-xs font-medium text-[#808080]\" data-kid=\"1-1-1-2-2-1\" data-name=\"access group label\">\n                        الوصول والاشتراكات\n                    </p>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-2-2\" data-name=\"access links container\">\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"users navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-people h-4 w-4 text-base\" data-kid=\"1-1-1-2-2-2-1-1\" data-name=\"users icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-2-2-1-2\" data-name=\"users label\">\n                                users\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"plans navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-gem h-4 w-4 text-base\" data-kid=\"1-1-1-2-2-2-2-1\" data-name=\"plans icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-2-2-2-2\" data-name=\"plans label\">\n                                plans\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"payments navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-credit-card h-4 w-4 text-base\" data-kid=\"1-1-1-2-2-2-3-1\" data-name=\"payments icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-2-2-3-2\" data-name=\"payments label\">\n                                payments\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-3\" data-name=\"broadcast sources group\">\n                    <p class=\"mb-2 px-3 text-xs font-medium text-[#808080]\" data-kid=\"1-1-1-2-3-1\" data-name=\"broadcast group label\">\n                        مصادر البث\n                    </p>\n                    <button aria-current=\"page\" class=\"flex w-full items-center gap-3 rounded-md bg-[#181818] px-3 py-2.5 text-left text-sm font-semibold text-[#e50914]\" data-kid=\"1-1-1-2-3-2\" data-name=\"servers active navigation button\" dir=\"ltr\" type=\"button\">\n                        <i class=\"bi bi-hdd-network h-4 w-4 text-base\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"servers icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-3-2-2\" data-name=\"servers label\">\n                            servers\n                        </span>\n                    </button>\n                </div>\n                <div data-kid=\"1-1-1-2-4\" data-name=\"content group\">\n                    <p class=\"mb-2 px-3 text-xs font-medium text-[#808080]\" data-kid=\"1-1-1-2-4-1\" data-name=\"content group label\">\n                        المحتوى\n                    </p>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-4-2\" data-name=\"content links container\">\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-4-2-1\" data-name=\"news navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-megaphone h-4 w-4 text-base\" data-kid=\"1-1-1-2-4-2-1-1\" data-name=\"news icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-4-2-1-2\" data-name=\"news label\">\n                                news\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-4-2-2\" data-name=\"pages navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-file-earmark-text h-4 w-4 text-base\" data-kid=\"1-1-1-2-4-2-2-1\" data-name=\"pages icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-4-2-2-2\" data-name=\"pages label\">\n                                pages\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-4-2-3\" data-name=\"widgets navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-puzzle h-4 w-4 text-base\" data-kid=\"1-1-1-2-4-2-3-1\" data-name=\"widgets icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-4-2-3-2\" data-name=\"widgets label\">\n                                widgets\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-5\" data-name=\"system group\">\n                    <p class=\"mb-2 px-3 text-xs font-medium text-[#808080]\" data-kid=\"1-1-1-2-5-1\" data-name=\"system group label\">\n                        النظام\n                    </p>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-5-2\" data-name=\"system links container\">\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-5-2-1\" data-name=\"logs navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-journal-text h-4 w-4 text-base\" data-kid=\"1-1-1-2-5-2-1-1\" data-name=\"logs icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-5-2-1-2\" data-name=\"logs label\">\n                                logs\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-5-2-2\" data-name=\"settings navigation button\" dir=\"ltr\" type=\"button\">\n                            <i class=\"bi bi-gear h-4 w-4 text-base\" data-kid=\"1-1-1-2-5-2-2-1\" data-name=\"settings icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-5-2-2-2\" data-name=\"settings label\">\n                                settings\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </nav>\n            <button class=\"mt-8 flex items-center gap-3 border-t border-[#2f2f2f] px-3 pt-5 text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-3\" data-name=\"return to watch button\" type=\"button\">\n                <i class=\"bi bi-play-circle text-base\" data-kid=\"1-1-1-3-1\" data-name=\"return to watch icon\">\n                </i>\n                <span data-kid=\"1-1-1-3-2\" data-name=\"return to watch label\">\n                    العودة إلى المشاهدة\n                </span>\n            </button>\n        </aside>\n        <main class=\"min-w-0 bg-black\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header class=\"flex h-[72px] items-center justify-between border-b border-[#2f2f2f] px-6 lg:px-9\" data-kid=\"1-1-2-1\" data-name=\"top header bar\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"mobile navigation controls container\">\n                    <button aria-label=\"فتح القائمة\" class=\"flex h-9 w-9 items-center justify-center rounded-md bg-[#141414] text-[#a8a8a8] lg:hidden\" data-kid=\"1-1-2-1-1-1\" data-name=\"mobile menu button\" type=\"button\">\n                        <i class=\"bi bi-list text-xl\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"mobile menu icon\">\n                        </i>\n                    </button>\n                    <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-1-2-1-1-2\" data-name=\"page title indicator\">\n                        إدارة النظام\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-2\" data-name=\"admin profile status container\">\n                    <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#181818] text-[#a8a8a8]\" data-kid=\"1-1-2-1-2-1\" data-name=\"admin shield icon container\">\n                        <i class=\"bi bi-shield-lock\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"admin shield icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-sm font-medium text-white\" data-kid=\"1-1-2-1-2-2\" data-name=\"admin account label\">\n                        حساب المشرف\n                    </span>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1280px] px-6 py-8 lg:px-9 lg:py-10\" data-kid=\"1-1-2-2\" data-name=\"page content section\">\n                <div class=\"mb-8 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-1-2-2-1\" data-name=\"page breadcrumbs and actions header\">\n                    <div data-kid=\"1-1-2-2-1-1\" data-name=\"breadcrumb and title container\">\n                        <div class=\"mb-3 flex items-center gap-2 text-sm text-[#808080]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"breadcrumbs navigation path\">\n                            <span data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"administration label\">\n                                الإدارة\n                            </span>\n                            <i class=\"bi bi-chevron-left text-[10px]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"breadcrumb separator icon\">\n                            </i>\n                            <span class=\"text-[#a8a8a8]\" data-kid=\"1-1-2-2-1-1-1-3\" data-name=\"current page label\">\n                                servers\n                            </span>\n                        </div>\n                        <h1 class=\"text-3xl font-bold tracking-tight text-white\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"page main heading\">\n                            الخوادم\n                        </h1>\n                        <p class=\"mt-2 text-sm text-[#a8a8a8]\" data-kid=\"1-1-2-2-1-1-3\" data-name=\"page description\">\n                            إدارة مصادر Xtream العامة المتاحة للمستخدمين.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-1-2\" data-name=\"action buttons container\">\n                        <button class=\"flex items-center gap-2 rounded-md border border-[#333] px-4 py-2.5 text-sm font-medium text-[#d4d4d4]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"users link button\" type=\"button\">\n                            <i class=\"bi bi-people text-[#a8a8a8]\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"users button icon\">\n                            </i>\n                            <span data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"users button label\">\n                                المستخدمون\n                            </span>\n                        </button>\n                        <button class=\"flex items-center gap-2 rounded-md border border-[#333] px-4 py-2.5 text-sm font-medium text-[#d4d4d4]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"payments link button\" type=\"button\">\n                            <i class=\"bi bi-credit-card text-[#a8a8a8]\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"payments button icon\">\n                            </i>\n                            <span data-kid=\"1-1-2-2-1-2-2-2\" data-name=\"payments button label\">\n                                الدفعات\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <section aria-label=\"ملخص الإدارة\" class=\"mb-9 flex flex-wrap items-center gap-x-10 gap-y-4 border-y border-[#2f2f2f] py-5\" data-kid=\"1-1-2-2-2\" data-name=\"statistics overview bar\">\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"1-1-2-2-2-1\" data-name=\"servers stat container\">\n                        <span class=\"text-2xl font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"servers stat value\" data-reason=\"value replaced by dynamic database fetch\">\n                            —\n                        </span>\n                        <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"servers stat label\">\n                            الخوادم العامة\n                        </span>\n                    </div>\n                    <span class=\"hidden h-6 w-px bg-[#333] sm:block\" data-kid=\"1-1-2-2-2-2\" data-name=\"stat separator 1\">\n                    </span>\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"1-1-2-2-2-3\" data-name=\"users stat container\">\n                        <span class=\"text-2xl font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"users stat value\" data-reason=\"value replaced by dynamic database fetch\">\n                            —\n                        </span>\n                        <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"users stat label\">\n                            المستخدمون\n                        </span>\n                    </div>\n                    <span class=\"hidden h-6 w-px bg-[#333] sm:block\" data-kid=\"1-1-2-2-2-4\" data-name=\"stat separator 2\">\n                    </span>\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"1-1-2-2-2-5\" data-name=\"subscriptions stat container\">\n                        <span class=\"text-2xl font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-5-1\" data-name=\"subscriptions stat value\" data-reason=\"value replaced by dynamic database fetch\">\n                            —\n                        </span>\n                        <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-1-2-2-2-5-2\" data-name=\"subscriptions stat label\">\n                            الاشتراكات المدفوعة\n                        </span>\n                    </div>\n                </section>\n                <section aria-labelledby=\"servers-heading\" class=\"overflow-hidden rounded-lg bg-[#141414]\" data-kid=\"1-1-2-2-3\" data-name=\"servers management table card\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-5 px-5 py-5 lg:px-6\" data-kid=\"1-1-2-2-3-1\" data-name=\"table header section\">\n                        <div data-kid=\"1-1-2-2-3-1-1\" data-name=\"table title and description\">\n                            <h2 class=\"text-lg font-semibold text-white\" data-kid=\"1-1-2-2-3-1-1-1\" data-name=\"table main heading\" id=\"servers-heading\">\n                                خوادم Xtream العامة\n                            </h2>\n                            <p class=\"mt-1 text-sm text-[#808080]\" data-kid=\"1-1-2-2-3-1-1-2\" data-name=\"table description\">\n                                مصادر البث التي يديرها المشرف.\n                            </p>\n                        </div>\n                        <div class=\"w-full max-w-[390px]\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"search input container\">\n                            <label class=\"mb-2 block text-sm font-medium text-[#d4d4d4]\" data-kid=\"1-1-2-2-3-1-2-1\" data-name=\"search input label\" for=\"server-search\">\n                                البحث في الخوادم\n                            </label>\n                            <div class=\"flex h-11 items-center gap-3 rounded-md border border-[#333] bg-[#0b0b0b] px-3 text-[#808080]\" data-kid=\"1-1-2-2-3-1-2-2\" data-name=\"search input field wrapper\">\n                                <i class=\"bi bi-search text-base\" data-kid=\"1-1-2-2-3-1-2-2-1\" data-name=\"search icon\">\n                                </i>\n                                <input class=\"w-full bg-transparent text-sm text-white outline-none placeholder:text-[#808080]\" data-kid=\"1-1-2-2-3-1-2-2-2\" data-name=\"server search input\" id=\"server-search\" placeholder=\"الاسم أو المضيف\" type=\"search\"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"overflow-x-auto\" data-kid=\"1-1-2-2-3-2\" data-name=\"table body wrapper\">\n                        <table class=\"w-full min-w-[830px] border-collapse text-right\" data-kid=\"1-1-2-2-3-2-1\" data-name=\"servers table\">\n                            <thead data-kid=\"1-1-2-2-3-2-1-1\" data-name=\"table header row container\">\n                                <tr class=\"border-y border-[#333] text-xs font-medium text-[#a8a8a8]\" data-kid=\"1-1-2-2-3-2-1-1-1\" data-name=\"table header row\">\n                                    <th class=\"px-5 py-3.5 font-medium lg:px-6\" data-kid=\"1-1-2-2-3-2-1-1-1-1\" data-name=\"server name header\" scope=\"col\">\n                                        اسم الخادم\n                                    </th>\n                                    <th class=\"px-4 py-3.5 font-medium\" data-kid=\"1-1-2-2-3-2-1-1-1-2\" data-name=\"host header\" scope=\"col\">\n                                        المضيف\n                                    </th>\n                                    <th class=\"px-4 py-3.5 font-medium\" data-kid=\"1-1-2-2-3-2-1-1-1-3\" data-name=\"username header\" scope=\"col\">\n                                        اسم المستخدم\n                                    </th>\n                                    <th class=\"px-4 py-3.5 font-medium\" data-kid=\"1-1-2-2-3-2-1-1-1-4\" data-name=\"m3u link header\" scope=\"col\">\n                                        رابط M3U\n                                    </th>\n                                    <th class=\"px-4 py-3.5 font-medium\" data-kid=\"1-1-2-2-3-2-1-1-1-5\" data-name=\"created at header\" scope=\"col\">\n                                        تاريخ الإنشاء\n                                    </th>\n                                    <th class=\"px-5 py-3.5 text-left font-medium lg:px-6\" data-kid=\"1-1-2-2-3-2-1-1-1-6\" data-name=\"actions header\" scope=\"col\">\n                                        الإجراءات\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-1-2\" data-name=\"table body\" data-reason=\"content dynamically populated from database list\">\n                                <tr data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-1-2-1\" data-name=\"empty state row\" data-reason=\"row shown only if no data is present\">\n                                    <td class=\"px-6 py-20 text-center\" colspan=\"6\" data-kid=\"1-1-2-2-3-2-1-2-1-1\" data-name=\"empty state cell\">\n                                        <div class=\"mx-auto flex max-w-sm flex-col items-center\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1\" data-name=\"empty state content\">\n                                            <span class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-[#181818] text-xl text-[#a8a8a8]\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-1\" data-name=\"empty state icon container\">\n                                                <i class=\"bi bi-hdd-network\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-1-1\" data-name=\"empty state icon\">\n                                                </i>\n                                            </span>\n                                            <h3 class=\"text-base font-semibold text-white\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-2\" data-name=\"empty state heading\">\n                                                لا توجد سجلات خوادم في هذه المعاينة\n                                            </h3>\n                                            <p class=\"mt-2 text-sm leading-6 text-[#a8a8a8]\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-3\" data-name=\"empty state message\">\n                                                ستظهر الخوادم العامة هنا بعد إضافتها.\n                                            </p>\n                                            <button class=\"mt-6 inline-flex min-h-11 items-center gap-2 rounded-md bg-[#e50914] px-5 py-2.5 text-sm font-semibold text-white\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-4\" data-name=\"add server button\" type=\"button\">\n                                                <i class=\"bi bi-plus-lg\" data-kid=\"1-1-2-2-3-2-1-2-1-1-1-4-1\" data-name=\"add server icon\">\n                                                </i>\n                                                <span data-kid=\"1-1-2-2-3-2-1-2-1-1-1-4-2\" data-name=\"add server label\">\n                                                    إضافة خادم\n                                                </span>\n                                            </button>\n                                        </div>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <div class=\"flex flex-wrap items-center justify-between gap-3 border-t border-[#2f2f2f] px-5 py-4 text-xs text-[#808080] lg:px-6\" data-kid=\"1-1-2-2-3-3\" data-name=\"table footer\">\n                        <span data-kid=\"1-1-2-2-3-3-1\" data-name=\"footer status message\">\n                            بيانات السجل تُحمّل من قاعدة بيانات الإدارة.\n                        </span>\n                        <span data-kid=\"1-1-2-2-3-3-2\" data-name=\"footer disclaimer text\">\n                            لا توجد بيانات تجريبية معروضة\n                        </span>\n                    </div>\n                </section>\n            </div>\n        </main>\n    </div>\n</div>\n",
