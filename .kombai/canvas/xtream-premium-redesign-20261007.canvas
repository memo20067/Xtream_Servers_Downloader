"indicator dot\">\n                            </span>\n                            <span data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"status label\">\n                                بانتظار المراجعة\n                            </span>\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-x-5 gap-y-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"status filter options\">\n                            <span data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"status filter prefix\">\n                                الحالات:\n                            </span>\n                            <span data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"pending filter option\">\n                                Pending\n                            </span>\n                            <span data-kid=\"1-2-2-3-2-1-2-3\" data-name=\"verified filter option\">\n                                Verified\n                            </span>\n                            <span data-kid=\"1-2-2-3-2-1-2-4\" data-name=\"rejected filter option\">\n                                Rejected\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"overflow-x-auto\" data-kid=\"1-2-2-3-2-2\" data-name=\"table wrapper\">\n                        <table class=\"w-full min-w-[650px] text-right border-collapse\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"receipts table\">\n                            <thead class=\"bg-[var(--raised)] text-[11px] text-[var(--muted)] font-medium\" data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"table header row\">\n                                <tr data-kid=\"1-2-2-3-2-2-1-1-1\" data-name=\"user header\">\n                                    <th class=\"px-5 py-3 font-medium\" data-kid=\"1-2-2-3-2-2-1-1-1-1\">\n                                        المستخدم\n                                    </th>\n                                    <th class=\"px-5 py