      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n:root{--canvas:#000000;--surface:#141414;--surface-raised:#181818;--ink:#ffffff;--muted:#a8a8a8;--dim:#808080;--edge:#333333;--brand:#e50914;--brand-dark:#b20710}\n.auth-field:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px rgba(229,9,20,.22)}\n@media(max-width:900px){.auth-layout{grid-template-columns:1fr!important;gap:28px!important}.identity-block{padding:28px!important;min-height:260px!important}.identity-lines{font-size:clamp(44px,11vw,76px)!important}.auth-form-panel{padding:28px!important}.auth-container{padding:20px!important}.auth-header{margin-bottom:20px!important}.identity-caption{max-width:34rem}}\n@media(max-width:520px){.identity-lines{font-size:47px!important;line-height:1.12!important}.identity-block{min-height:220px!important}.auth-form-panel{padding:24px 20px!important}.auth-container{padding:14px!important}}\n</style>\n<div class=\"min-h-screen bg-[var(--canvas)] text-[var(--ink)] font-['Noto_Sans_Arabic',Inter,sans-serif]\" data-kid=\"1\" data-name=\"auth page main container\" dir=\"rtl\" lang=\"ar\">\n    <header class=\"auth-header mx-auto flex max-w-[1320px] items-center justify-between px-8 py-7 md:px-12 lg:px-16\" data-kid=\"1-1\" data-name=\"header section\">\n        <a aria-label=\"Xtream IPTV\" class=\"flex items-center gap-3 text-white no-underline\" data-kid=\"1-1-1\" data-name=\"site branding link\" href=\"#\">\n            <span class=\"flex h-10 w-10 items-center justify-center rounded-[4px] bg-[var(--surface-raised)] text-[var(--brand)]\" data-kid=\"1-1-1-1\" data-name=\"branding logo container\">\n                <i class=\"bi bi-tv-fill text-[19px]\" data-kid=\"1-1-1-1-1\" data-name=\"tv icon\">\n                </i>\n            </span>\n            <span class=\"font-['Inter',sans-serif] text-[15px] font-bold tracking-[.08em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                XTREAM IPTV\n            </span>\n        </a>\n        <button aria-label=\"Switch language to English\" class=\"rounded-[4px] border border-[var(--edge)] bg-transparent px-4 py-2 text-[12px] font-semibold text-[var(--muted)] hover:border-[var(--muted)] hover:text-white focus-visible:outline-2 focus-visible:outline-[var(--brand)]\" data-kid=\"1-1-2\" data-name=\"language switcher button\" type=\"button\">\n            English\n            <span class=\"ms-1 text-[var(--dim)]\" data-kid=\"1-1-2-1\" data-name=\"language code text\">\n                EN\n            </span>\n        </button>\n    </header>\n    <main class=\"auth-container mx-auto flex min-h-[calc(100vh-88px)] max-w-[1320px] items-center px-8 pb-10 pt-3 md:px-12 lg:px-16\" data-kid=\"1-2\" data-name=\"main authentication content wrapper\">\n        <div class=\"auth-layout grid w-full grid-cols-[minmax(0,1fr)_minmax(420px,520px)] items-stretch gap-20\" data-kid=\"1-2-1\" data-name=\"authentication layout grid container\">\n            <section aria-label=\"Xtream IPTV\" class=\"identity-block relative flex min-h-[560px] flex-col justify-between overflow-hidden rounded-[8px] bg-[var(--surface)] px-12 py-12\" data-kid=\"1-2-1-1\" data-name=\"hero identity panel\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-1\" data-name=\"brand tag container\">\n                    <span class=\"h-[2px] w-9 bg-[var(--brand)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"brand tag separator line\">\n                    </span>\n                    <span class=\"font-['Inter',sans-serif] text-[11px] font-semibold tracking-[.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-2\" data-name=\"brand tag name text\">\n                        XTREAM IPTV\n                    </span>\n                </div>\n                <div class=\"identity-caption relative z-10 max-w-[550px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline wrapper\">\n                    <h1 class=\"identity-lines m-0 text-[clamp(58px,6vw,88px)] font-bold leading-[1.2] tracking-[-.055em]\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero headlines list\">\n                        <span class=\"block text-white\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"live streaming headline\">\n                            البث المباشر\n                        </span>\n                        <span class=\"block text-[#a8a8a8]\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"movies headline\">\n                            الأفلام\n                        </span>\n                        <span class=\"block text-[#555555]\" data-kid=\"1-2-1-1-2-1-3\" data-name=\"series headline\">\n                            المسلسلات\n                        </span>\n                    </h1>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 border-t border-[var(--edge)] pt-5 text-[12px] text-[var(--dim)]\" data-kid=\"1-2-1-1-3\" data-name=\"hero footer info container\">\n                    <span data-kid=\"1-2-1-1-3-1\" data-name=\"hero caption text\">\n                        مشاهدة · بحث · تشغيل\n                    </span>\n                    <span class=\"font-['Inter',sans-serif] tracking-[.12em]\" data-kid=\"1-2-1-1-3-2\" data-name=\"hero media format labels\" dir=\"ltr\">\n                        LIVE / VOD\n                    </span>\n                </div>\n                <div aria-hidden=\"true\" class=\"pointer-events-none absolute -bottom-28 -left-20 select-none font-['Inter',sans-serif] text-[360px] font-bold leading-none tracking-[-.12em] text-white/[.025]\" data-kid=\"1-2-1-1-4\" data-name=\"background decorative letter X\">\n                    X\n                </div>\n            </section>\n            <section class=\"flex items-center justify-center py-4\" data-kid=\"1-2-1-2\" data-name=\"login form panel wrapper\">\n                <div class=\"auth-form-panel w-full max-w-[480px] rounded-[8px] bg-[var(--surface)] px-10 py-11 md:px-12\" data-kid=\"1-2-1-2-1\" data-name=\"login form container\">\n                    <div class=\"mb-9\" data-kid=\"1-2-1-2-1-1\" data-name=\"login header info block\">\n                        <div class=\"mb-4 flex h-11 w-11 items-center justify-center rounded-[4px] bg-[var(--surface-raised)] text-[var(--brand)]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"login icon container\">\n                            <i class=\"bi bi-play-fill text-[26px]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"play icon\">\n                            </i>\n                        </div>\n                        <h2 class=\"m-0 text-[30px] font-bold leading-tight tracking-[-.04em]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"login title text\">\n                            تسجيل الدخول\n                        </h2>\n                        <p class=\"mb-0 mt-3 text-[14px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-1-2-1-1-3\" data-name=\"login instructions text\">\n                            أدخل اسم المستخدم أو البريد الإلكتروني وكلمة المرور.\n                        </p>\n                    </div>\n                    <form action=\"login.php\" class=\"space-y-6\" data-kid=\"1-2-1-2-1-2\" data-name=\"login form\" method=\"post\">\n                        <div data-kid=\"1-2-1-2-1-2-1\" data-name=\"username field container\">\n                            <label class=\"mb-2 block text-[13px] font-medium text-[#e8e8e8]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"username label\" for=\"username\">\n                                اسم المستخدم أو البريد الإلكتروني\n                            </label>\n                            <input autocomplete=\"username\" class=\"auth-field h-[50px] w-full rounded-[4px] border border-[var(--edge)] bg-[#0b0b0b] px-4 text-[15px] text-white placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"username input field\" id=\"username\" name=\"username\" required=\"\" type=\"text\"/>\n                        </div>\n                        <div data-kid=\"1-2-1-2-1-2-2\" data-name=\"password field container\">\n                            <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"password header wrapper\">\n                                <label class=\"block text-[13px] font-medium text-[#e8e8e8]\" data-kid=\"1-2-1-2-1-2-2-1-1\" data-name=\"password label\" for=\"password\">\n                                    كلمة المرور\n                                </label>\n                                <a class=\"text-[12px] text-[var(--muted)] underline decoration-[#555555] underline-offset-4 hover:text-white\" data-kid=\"1-2-1-2-1-2-2-1-2\" data-name=\"forgot password link\" href=\"forgot_password.php\">\n                                    نسيت كلمة المرور؟\n                                </a>\n                            </div>\n                            <input autocomplete=\"current-password\" class=\"auth-field h-[50px] w-full rounded-[4px] border border-[var(--edge)] bg-[#0b0b0b] px-4 text-[15px] text-white\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" required=\"\" type=\"password\"/>\n                        </div>\n                        <button class=\"flex h-[50px] w-full items-center justify-center gap-2 rounded-[4px] bg-[var(--brand)] px-5 text-[15px] font-bold text-white hover:bg-[var(--brand-dark)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"submit login button\" type=\"submit\">\n                            <span data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"submit button text\">\n                                تسجيل الدخول\n                            </span>\n                            <i aria-hidden=\"true\" class=\"bi bi-arrow-left text-[15px]\" data-kid=\"1-2-1-2-1-2-3-2\" data-name=\"arrow right icon\">\n                            </i>\n                        </button>\n                    </form>\n                    <div class=\"mt-7 border-t border-[var(--edge)] pt-6 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-3\" data-name=\"registration prompt container\">\n                        <span data-kid=\"1-2-1-2-1-3-1\" data-name=\"registration question text\">\n                            ليس لديك حساب؟\n                        </span>\n                        <a class=\"me-1 font-semibold text-white underline decoration-[var(--brand)] underline-offset-4 hover:text-[#dddddd]\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"create account link\" href=\"register.php\">\n                            إنشاء حساب\n                        </a>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"mx-auto flex max-w-[1320px] items-center justify-between px-8 pb-5 text-[11px] text-[var(--dim)] md:px-12 lg:px-16\" data-kid=\"1-3\" data-name=\"footer section\">\n        <span data-kid=\"1-3-1\" data-name=\"footer copyright brand name\">\n            Xtream IPTV\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer content summary\">\n            قنوات مباشرة · أفلام · مسلسلات\n        </span>\n    </footer>\n</div>\n",
