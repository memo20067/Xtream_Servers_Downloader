      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#000000] text-white\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\" style=\"font-family:'Noto Sans Arabic',Inter,sans-serif\">\n    <header class=\"border-b border-[#262626] bg-[#000000]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:h-[78px] lg:flex-nowrap lg:py-0\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-sm bg-[#141414] text-[#e50914]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo background\">\n                    <i class=\"bi bi-display text-[21px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand display icon\">\n                    </i>\n                </div>\n                <div class=\"leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand text group\">\n                    <div class=\"text-[21px] font-bold tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title\">\n                        مدار\n                    </div>\n                    <div class=\"mt-0.5 text-[11px] text-[#a8a8a8]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand description\">\n                        مكتبة البث\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"order-3 flex w-full items-center gap-7 overflow-x-auto text-[14px] sm:order-none sm:w-auto sm:gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <button class=\"relative whitespace-nowrap py-2 font-semibold text-white after:absolute after:inset-x-0 after:-bottom-[18px] after:h-[2px] after:bg-[#e50914]\" data-kid=\"1-1-1-2-1\" data-name=\"live broadcast button\" type=\"button\">\n                    البث المباشر\n                </button>\n                <button class=\"whitespace-nowrap py-2 text-[#a8a8a8] hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"movies category button\" type=\"button\">\n                    الأفلام\n                </button>\n                <button class=\"whitespace-nowrap py-2 text-[#a8a8a8] hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"series category button\" type=\"button\">\n                    المسلسلات\n                </button>\n            </nav>\n            <div class=\"flex items-center gap-3 sm:gap-4\" data-kid=\"1-1-1-3\" data-name=\"header utility controls\">\n                <div class=\"flex items-center rounded-sm bg-[#141414] p-1 text-[12px]\" data-kid=\"1-1-1-3-1\" data-name=\"source type toggle group\">\n                    <button class=\"rounded-xs bg-[#262626] px-3 py-1.5 font-semibold text-white\" data-kid=\"1-1-1-3-1-1\" data-name=\"xtream source button\" type=\"button\">\n                        Xtream\n                    </button>\n                    <button class=\"px-3 py-1.5 text-[#a8a8a8]\" data-kid=\"1-1-1-3-1-2\" data-name=\"m3u source button\" type=\"button\">\n                        M3U / M3U8\n                    </button>\n                </div>\n                <button class=\"hidden items-center gap-2 whitespace-nowrap text-[12px] text-[#a8a8a8] sm:flex\" data-kid=\"1-1-1-3-2\" data-name=\"add source button\" type=\"button\">\n                    <i class=\"bi bi-plus-lg text-[14px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"add source icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\" data-name=\"add source label\">\n                        إضافة مصدر\n                    </span>\n                </button>\n                <span class=\"hidden h-5 w-px bg-[#333333] sm:block\" data-kid=\"1-1-1-3-3\" data-name=\"header separator line\">\n                </span>\n                <button class=\"text-[12px] font-semibold text-[#a8a8a8]\" data-kid=\"1-1-1-3-4\" data-name=\"language selector button\" type=\"button\">\n                    AR\n                    <span class=\"px-1 text-[#555]\" data-kid=\"1-1-1-3-4-1\" data-name=\"language separator slash\">\n                        /\n                    </span>\n                    EN\n                </button>\n                <button aria-label=\"الملف الشخصي\" class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#181818] text-[#d4d4d4]\" data-kid=\"1-1-1-3-5\" data-name=\"profile access button\" type=\"button\">\n                    <i class=\"bi bi-person text-[17px]\" data-kid=\"1-1-1-3-5-1\" data-name=\"profile icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-5 pb-10 pt-8 sm:px-8 lg:pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex flex-col justify-between gap-5 lg:flex-row lg:items-end\" data-kid=\"1-2-1\" data-name=\"header and filter controls row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading group\">\n                <h1 class=\"text-[28px] font-bold tracking-tight sm:text-[34px]\" data-kid=\"1-2-1-1-1\" data-name=\"page main title\">\n                    شاهد القنوات الآن\n                </h1>\n                <p class=\"mt-2 text-[14px] text-[#a8a8a8]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    اختر قناة وابدأ المشاهدة مباشرة.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"source filter control group\">\n                <label class=\"text-[12px] font-medium text-[#a8a8a8]\" data-kid=\"1-2-1-2-1\" data-name=\"source label\" for=\"source-server\">\n                    المصدر\n                </label>\n                <div class=\"relative min-w-[190px]\" data-kid=\"1-2-1-2-2\" data-name=\"source select wrapper\">\n                    <select class=\"w-full appearance-none rounded-sm border border-[#333333] bg-[#141414] py-2.5 pe-4 ps-10 text-[13px] text-white outline-none\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1\" data-name=\"source selector dropdown\" data-reason=\"options populated from external source data\" id=\"source-server\">\n                        <option data-kid=\"1-2-1-2-2-1-1\">\n                            Xtream Codes\n                        </option>\n                    </select>\n                    <i class=\"bi bi-chevron-down pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-1-2-2-2\" data-name=\"dropdown chevron icon\">\n                    </i>\n                </div>\n                <span class=\"inline-flex items-center gap-2 border-r border-[#333333] pr-3 text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-1-2-3\" data-name=\"channel count status indicator\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#e50914]\" data-kid=\"1-2-1-2-3-1\" data-name=\"active channel status dot\">\n                    </span>\n                    قائمة القنوات\n                </span>\n            </div>\n        </div>\n        <div class=\"mb-7 grid gap-3 sm:grid-cols-[minmax(260px,1fr)_220px]\" data-kid=\"1-2-2\" data-name=\"search and category filter row\">\n            <label class=\"flex min-h-[48px] items-center gap-3 border-b border-[#404040] bg-[#101010] px-4 focus-within:border-[#e50914]\" data-kid=\"1-2-2-1\" data-name=\"channel search field container\">\n                <i class=\"bi bi-search text-[15px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"sr-only\" data-kid=\"1-2-2-1-2\" data-name=\"search screen-reader label\">\n                    ابحث عن قناة أو عنوان\n                </span>\n                <input class=\"min-w-0 flex-1 bg-transparent text-[13px] text-white outline-none placeholder:text-[#808080]\" data-kid=\"1-2-2-1-3\" data-name=\"channel search input\" placeholder=\"ابحث عن قناة أو عنوان\" type=\"search\"/>\n                <span class=\"hidden text-[11px] text-[#666] sm:inline\" data-kid=\"1-2-2-1-4\" data-name=\"search hint text\">\n                    بحث في المصدر المحدد\n                </span>\n            </label>\n            <label class=\"flex min-h-[48px] items-center gap-3 border-b border-[#404040] bg-[#101010] px-4\" data-kid=\"1-2-2-2\" data-name=\"category filter container\">\n                <span class=\"text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-2-2-1\" data-name=\"category filter label\">\n                    الفئة\n                </span>\n                <select class=\"min-w-0 flex-1 appearance-none bg-transparent text-[13px] text-white outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"category selector dropdown\" data-reason=\"options populated from external source data\">\n                    <option data-kid=\"1-2-2-2-2-1\">\n                        كل الفئات\n                    </option>\n                </select>\n                <i class=\"bi bi-chevron-down text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-2-2-3\" data-name=\"category dropdown chevron\">\n                </i>\n            </label>\n        </div>\n        <div class=\"grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12\" data-kid=\"1-2-3\" data-name=\"main channel and library grid\">\n            <section aria-labelledby=\"channels-heading\" class=\"min-w-0\" data-kid=\"1-2-3-1\" data-name=\"channels section\">\n                <div class=\"mb-4 flex items-end justify-between gap-4\" data-kid=\"1-2-3-1-1\" data-name=\"channels section header row\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"channels title group\">\n                        <h2 class=\"text-[20px] font-bold\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"channels section heading\" id=\"channels-heading\">\n                            القنوات\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#808080]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"channels section description\">\n                            بيانات البرامج تظهر عند توفرها من المصدر.\n                        </p>\n                    </div>\n                    <button class=\"hidden items-center gap-2 text-[12px] text-[#a8a8a8] sm:flex\" data-kid=\"1-2-3-1-1-2\" data-name=\"view list button\" type=\"button\">\n                        <i class=\"bi bi-list-ul text-[15px]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"view list icon\">\n                        </i>\n                        عرض القائمة\n                    </button>\n                </div>\n                <div class=\"overflow-hidden border-y border-[#333333]\" data-kid=\"1-2-3-1-2\" data-name=\"channels table container\">\n                    <div class=\"hidden grid-cols-[minmax(210px,1.15fr)_minmax(150px,1fr)_minmax(150px,1fr)_auto] items-center gap-4 border-b border-[#333333] px-4 py-3 text-[11px] font-medium text-[#808080] lg:grid\" data-kid=\"1-2-3-1-2-1\" data-name=\"table header row\">\n                        <span data-kid=\"1-2-3-1-2-1-1\" data-name=\"channel column header\">\n                            القناة\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-2\" data-name=\"now column header\">\n                            الآن\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-3\" data-name=\"next column header\">\n                            التالي\n                        </span>\n                        <span class=\"ps-4\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"action column header\">\n                            التشغيل\n                        </span>\n                    </div>\n                    <article class=\"grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-4 bg-[#0b0b0b] px-3 py-4 sm:px-4 lg:grid-cols-[minmax(210px,1.15fr)_minmax(150px,1fr)_minmax(150px,1fr)_auto] lg:gap-4\" data-kid=\"1-2-3-1-2-2\" data-name=\"channel row item\">\n                        <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"channel info group\">\n                            <div class=\"flex h-[66px] w-[82px] shrink-0 items-center justify-center overflow-hidden bg-white p-1\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"channel logo background\">\n                                <img alt=\"شعار beIN SPORTS 1 4K من ذاكرة المشروع\" class=\"max-h-full max-w-full object-contain\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-1-1\" data-name=\"channel logo image\" data-reason=\"image source fetched from external channel data\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/live/9393d33bfc62c6e0a42367ea4baf12b7.png\"/>\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"channel details group\">\n                                <h3 class=\"truncate text-[14px] font-semibold leading-6 sm:text-[15px]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-name=\"channel name\" data-reason=\"text content populated from external channel data\">\n                                    beIN SPORTS 1\n                                </h3>\n                                <div class=\"mt-1 flex items-center gap-2 text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-3-1-2-2-1-2-2\" data-name=\"channel metadata tags group\">\n                                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-2-1-2-2-1\" data-name=\"live broadcast tag\">\n                                        <i class=\"bi bi-broadcast text-[12px]\" data-kid=\"1-2-3-1-2-2-1-2-2-1-1\" data-name=\"live broadcast icon\">\n                                        </i>\n                                        قناة مباشرة\n                                    </span>\n                                    <span class=\"h-1 w-1 rounded-full bg-[#555]\" data-kid=\"1-2-3-1-2-2-1-2-2-2\" data-name=\"metadata separator dot\">\n                                    </span>\n                                    <span data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-2-3\" data-name=\"channel resolution tag\" data-reason=\"text content populated from external channel data\">\n                                        4K\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"hidden min-w-0 lg:block\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"channel now playing info\" data-reason=\"text content populated from external channel data\">\n                            <p class=\"text-[12px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"channel now playing text\" data-reason=\"text content populated from external channel data\">\n                                غير متاح لهذا المصدر\n                            </p>\n                        </div>\n                        <div class=\"hidden min-w-0 lg:block\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"channel next playing info\" data-reason=\"text content populated from external channel data\">\n                            <p class=\"text-[12px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"channel next playing text\" data-reason=\"text content populated from external channel data\">\n                                غير متاح لهذا المصدر\n                            </p>\n                        </div>\n                        <button class=\"inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-xs bg-[#e50914] px-4 text-[12px] font-bold text-white sm:px-5\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"play channel button\" type=\"button\">\n                            <i class=\"bi bi-play-fill text-[17px]\" data-kid=\"1-2-3-1-2-2-4-1\" data-name=\"play channel icon\">\n                            </i>\n                            <span data-kid=\"1-2-3-1-2-2-4-2\" data-name=\"play channel label\">\n                                شغّل القناة\n                            </span>\n                        </button>\n                        <div class=\"col-span-2 grid grid-cols-2 gap-3 border-t border-[#262626] pt-3 lg:hidden\" data-kid=\"1-2-3-1-2-2-5\" data-name=\"mobile detail view row\">\n                            <div data-kid=\"1-2-3-1-2-2-5-1\" data-name=\"mobile now playing group\">\n                                <span class=\"block text-[10px] text-[#666]\" data-kid=\"1-2-3-1-2-2-5-1-1\" data-name=\"mobile now playing label\">\n                                    الآن\n                                </span>\n                                <span class=\"mt-1 block text-[11px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-5-1-2\" data-name=\"mobile now playing text\" data-reason=\"text content populated from external channel data\">\n                                    غير متاح لهذا المصدر\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-3-1-2-2-5-2\" data-name=\"mobile next playing group\">\n                                <span class=\"block text-[10px] text-[#666]\" data-kid=\"1-2-3-1-2-2-5-2-1\" data-name=\"mobile next playing label\">\n                                    التالي\n                                </span>\n                                <span class=\"mt-1 block text-[11px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-5-2-2\" data-name=\"mobile next playing text\" data-reason=\"text content populated from external channel data\">\n                                    غير متاح لهذا المصدر\n                                </span>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n                <p class=\"mt-3 text-[11px] text-[#666]\" data-kid=\"1-2-3-1-3\" data-name=\"channels disclaimer text\">\n                    قد يختلف توفر دليل البرامج من مصدر إلى آخر.\n                </p>\n            </section>\n            <aside aria-labelledby=\"library-heading\" class=\"min-w-0 border-t border-[#333333] pt-5 lg:border-t-0 lg:pt-0\" data-kid=\"1-2-3-2\" data-name=\"library sidebar section\">\n                <div class=\"mb-4 flex items-end justify-between\" data-kid=\"1-2-3-2-1\" data-name=\"library header row\">\n                    <div data-kid=\"1-2-3-2-1-1\" data-name=\"library title group\">\n                        <h2 class=\"text-[20px] font-bold\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"library section heading\" id=\"library-heading\">\n                            من المكتبة\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#808080]\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"library section description\">\n                            الأفلام والمسلسلات\n                        </p>\n                    </div>\n                    <button aria-label=\"استعراض المكتبة\" class=\"flex h-8 w-8 items-center justify-center text-[#a8a8a8]\" data-kid=\"1-2-3-2-1-2\" data-name=\"browse library button\" type=\"button\">\n                        <i class=\"bi bi-arrow-left text-[15px]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"browse library icon\">\n                        </i>\n                    </button>\n                </div>\n                <article class=\"flex gap-4 border-b border-[#333333] py-4\" data-kid=\"1-2-3-2-2\" data-name=\"library entry item\">\n                    <div class=\"h-[116px] w-[78px] shrink-0 overflow-hidden bg-[#141414]\" data-kid=\"1-2-3-2-2-1\" data-name=\"library entry image background\">\n                        <img alt=\"ملصق مسلسل محفوظ في ذاكرة المشروع؛ عنوانه غير مؤكد\" class=\"h-full w-full object-cover\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"library entry image\" data-reason=\"image source populated from external library data\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/series/163873cd62df416de16bb5f1bd66f6e5.jpg\"/>\n                    </div>\n                    <div class=\"flex min-w-0 flex-1 flex-col items-start py-1\" data-kid=\"1-2-3-2-2-2\" data-name=\"library entry content\">\n                        <span class=\"text-[11px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"library entry type\" data-reason=\"text content populated from external library data\">\n                            مسلسلات\n                        </span>\n                        <h3 class=\"mt-2 text-[13px] font-semibold leading-6\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"library entry title\" data-reason=\"text content populated from external library data\">\n                            اسم العمل غير متاح\n                        </h3>\n                        <button class=\"mt-auto inline-flex items-center gap-1.5 pt-3 text-[12px] font-semibold text-white\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"view episodes button\" type=\"button\">\n                            <i class=\"bi bi-collection-play text-[14px] text-[#e50914]\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"view episodes icon\">\n                            </i>\n                            عرض الحلقات\n                        </button>\n                    </div>\n                </article>\n                <article class=\"flex gap-4 border-b border-[#333333] py-4\" data-kid=\"1-2-3-2-3\" data-name=\"library empty entry item\">\n                    <div class=\"flex h-[116px] w-[78px] shrink-0 flex-col items-center justify-center gap-2 bg-[#141414] text-[#666]\" data-kid=\"1-2-3-2-3-1\" data-name=\"placeholder icon container\">\n                        <i class=\"bi bi-camera-reels text-[22px]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"missing image icon\">\n                        </i>\n                        <span class=\"text-[10px]\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"missing image label\">\n                            لا توجد صورة\n                        </span>\n                    </div>\n                    <div class=\"flex min-w-0 flex-1 flex-col items-start py-1\" data-kid=\"1-2-3-2-3-2\" data-name=\"library empty entry content\">\n                        <span class=\"text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"library entry type\">\n                            أفلام\n                        </span>\n                        <h3 class=\"mt-2 text-[13px] font-semibold leading-6\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"library entry empty title\" data-reason=\"text content populated from external library data\">\n                            تظهر الأفلام من المصدر المحدد\n                        </h3>\n                        <button class=\"mt-auto inline-flex items-center gap-1.5 pt-3 text-[12px] font-semibold text-white\" data-kid=\"1-2-3-2-3-2-3\" data-name=\"browse movies button\" type=\"button\">\n                            <i class=\"bi bi-film text-[14px] text-[#e50914]\" data-kid=\"1-2-3-2-3-2-3-1\" data-name=\"browse movies icon\">\n                            </i>\n                            استعرض الأفلام\n                        </button>\n                    </div>\n                </article>\n                <div class=\"mt-5 flex items-start gap-3 text-[11px] leading-6 text-[#808080]\" data-kid=\"1-2-3-2-4\" data-name=\"library information footer\">\n                    <i class=\"bi bi-info-circle mt-1 text-[13px] text-[#a8a8a8]\" data-kid=\"1-2-3-2-4-1\" data-name=\"info icon\">\n                    </i>\n                    <p data-kid=\"1-2-3-2-4-2\" data-name=\"library information text\">\n                        تُعرض أسماء الأعمال وصورها بحسب البيانات المتاحة لدى المصدر.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <footer class=\"mt-10 border-t border-[#262626] pt-4 text-[11px] text-[#666]\" data-kid=\"1-2-4\" data-name=\"page footer area\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\" data-kid=\"1-2-4-1\" data-name=\"footer content wrapper\">\n                <span data-kid=\"1-2-4-1-1\" data-name=\"footer brand copyright\">\n                    مدار · مكتبة البث\n                </span>\n                <span data-kid=\"1-2-4-1-2\" data-name=\"footer subtitle description\">\n                    شاهد القنوات أو تصفّح مكتبتك\n                </span>\n            </div>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
