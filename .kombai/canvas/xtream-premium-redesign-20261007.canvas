      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n.xtream-plan-page { font-family: 'IBM Plex Sans Arabic', Inter, sans-serif; }\n.xtream-plan-page .latin { font-family: Inter, sans-serif; }\n.xtream-plan-page .table-scroll { scrollbar-color: #4b4b4b #141414; scrollbar-width: thin; }\n</style>\n<div class=\"xtream-plan-page min-h-screen bg-[#000000] text-[#ffffff]\" data-kid=\"1\" data-name=\"plan selection page container\" dir=\"rtl\" lang=\"ar\">\n    <header class=\"border-b border-[#242424] bg-[#000000]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1320px] items-center justify-between px-8 max-md:px-5\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo and title group\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-[6px] border border-[#424242] bg-[#141414] text-[17px] text-[#ffffff]\" data-kid=\"1-1-1-1-1\" data-name=\"logo icon container\">\n                    <i class=\"bi bi-tv\" data-kid=\"1-1-1-1-1-1\" data-name=\"tv icon\">\n                    </i>\n                </span>\n                <span class=\"text-[17px] font-bold tracking-[-0.02em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name\">\n                    Xtream\n                </span>\n                <span class=\"mx-2 hidden h-6 w-px bg-[#333333] sm:block\" data-kid=\"1-1-1-1-3\" data-name=\"separator line\">\n                </span>\n                <span class=\"hidden text-sm text-[#a8a8a8] sm:block\" data-kid=\"1-1-1-1-4\" data-name=\"header subtitle\">\n                    الاشتراك والدفع\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 text-[13px] text-[#a8a8a8]\" data-kid=\"1-1-1-2\" data-name=\"navigation link group\">\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"1-1-1-2-1\" data-name=\"account link\">\n                    <i class=\"bi bi-person-circle text-[16px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"person icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"account text\">\n                        حسابي\n                    </span>\n                </span>\n                <span class=\"hidden h-4 w-px bg-[#333333] sm:block\" data-kid=\"1-1-1-2-2\" data-name=\"separator line\">\n                </span>\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"1-1-1-2-3\" data-name=\"back to library link\">\n                    <i class=\"bi bi-arrow-return-left text-[14px]\" data-kid=\"1-1-1-2-3-1\" data-name=\"arrow return icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-3-2\" data-name=\"back to library text\">\n                        العودة للمكتبة\n                    </span>\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1320px] px-8 pb-14 pt-10 max-md:px-5 max-md:pt-7\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-8 flex items-end justify-between gap-6 max-lg:flex-col max-lg:items-start\" data-kid=\"1-2-1\" data-name=\"intro section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title group\">\n                <h1 class=\"m-0 text-[34px] font-bold leading-[1.25] tracking-[-0.035em] max-md:text-[27px]\" data-kid=\"1-2-1-1-1\" data-name=\"page title\">\n                    اختر باقتك\n                </h1>\n                <p class=\"mb-0 mt-2 text-[15px] leading-7 text-[#a8a8a8]\" data-kid=\"1-2-1-1-2\" data-name=\"page description\">\n                    قارن ما تتضمنه كل باقة، ثم تابع لاختيار وسيلة الدفع ورفع الإيصال.\n                </p>\n            </div>\n            <p class=\"mb-1 inline-flex items-center gap-2 text-[13px] text-[#a8a8a8]\" data-kid=\"1-2-1-2\" data-name=\"verification notice text\">\n                <i class=\"bi bi-shield-check text-[15px]\" data-kid=\"1-2-1-2-1\" data-name=\"shield check icon\">\n                </i>\n                لا يُفعّل الاشتراك قبل مراجعة الإيصال\n            </p>\n        </div>\n        <div class=\"grid grid-cols-[324px_minmax(0,1fr)] items-start gap-9 max-lg:grid-cols-1\" data-kid=\"1-2-2\" data-name=\"plan comparison section\">\n            <aside class=\"order-2 bg-[#141414] px-6 py-6 max-md:px-5\" data-kid=\"1-2-2-1\" data-name=\"selected plan summary sidebar\">\n                <div class=\"flex items-center justify-between border-b border-[#333333] pb-5\" data-kid=\"1-2-2-1-1\" data-name=\"summary header\">\n                    <h2 class=\"m-0 text-[18px] font-semibold\" data-kid=\"1-2-2-1-1-1\" data-name=\"summary title\">\n                        ملخص اختيارك\n                    </h2>\n                    <span class=\"text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-1-2\" data-name=\"summary subtitle\">\n                        الباقة المحددة\n                    </span>\n                </div>\n                <div class=\"pt-5\" data-kid=\"1-2-2-1-2\" data-name=\"summary details wrapper\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-2-1-2-1\" data-name=\"selected plan price row\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"plan name and duration group\">\n                            <p class=\"m-0 text-[20px] font-bold\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"selected plan title\">\n                                Basic Pass\n                            </p>\n                            <p class=\"mb-0 mt-1 text-[13px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"selected plan frequency\">\n                                اشتراك شهري\n                            </p>\n                        </div>\n                        <div class=\"text-left\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"price display container\" dir=\"ltr\">\n                            <span class=\"latin text-[25px] font-semibold tracking-[-0.04em]\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"price value\">\n                                $9.99\n                            </span>\n                            <span class=\"latin block text-[11px] text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"currency frequency label\">\n                                USD / month\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"my-5 h-px bg-[#333333]\" data-kid=\"1-2-2-1-2-2\" data-name=\"separator line\">\n                    </div>\n                    <p class=\"mb-3 text-[12px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-3\" data-name=\"features list label\">\n                        المزايا المسجلة لهذه الباقة\n                    </p>\n                    <ul class=\"m-0 list-none space-y-3 p-0 text-[13px] leading-6 text-[#e4e4e4]\" data-kid=\"1-2-2-1-2-4\" data-name=\"features list\">\n                        <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"feature item\">\n                            <span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#a8a8a8]\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"feature bullet\">\n                            </span>\n                            <span data-kid=\"1-2-2-1-2-4-1-2\" data-name=\"feature text\">\n                                قنوات البث المباشر القياسية\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"feature item\">\n                            <span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#a8a8a8]\" data-kid=\"1-2-2-1-2-4-2-1\" data-name=\"feature bullet\">\n                            </span>\n                            <span data-kid=\"1-2-2-1-2-4-2-2\" data-name=\"feature text\">\n                                بث بجودة HD\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"feature item\">\n                            <span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#a8a8a8]\" data-kid=\"1-2-2-1-2-4-3-1\" data-name=\"feature bullet\">\n                            </span>\n                            <span data-kid=\"1-2-2-1-2-4-3-2\" data-name=\"feature text\">\n                                تكامل مع سيرفر شخصي\n                            </span>\n                        </li>\n                    </ul>\n                    <button class=\"mt-7 flex min-h-[50px] w-full items-center justify-center gap-2 rounded-[4px] bg-[#e50914] px-4 text-[15px] font-bold text-white\" data-kid=\"1-2-2-1-2-5\" data-name=\"checkout call to action button\" type=\"button\">\n                        <span data-kid=\"1-2-2-1-2-5-1\" data-name=\"button label\">\n                            المتابعة لرفع الإيصال\n                        </span>\n                        <i class=\"bi bi-arrow-left text-[15px]\" data-kid=\"1-2-2-1-2-5-2\" data-name=\"arrow left icon\">\n                        </i>\n                    </button>\n                    <p class=\"mb-0 mt-3 text-center text-[12px] leading-6 text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-6\" data-name=\"checkout warning text\">\n                        بعد رفع الإيصال، تصبح حالته\n                        <span class=\"font-semibold text-[#ffffff]\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"warning highlighted text\">\n                            قيد مراجعة الإدارة\n                        </span>\n                        .\n                    </p>\n                    <div class=\"mt-5 border-t border-[#333333] pt-4\" data-kid=\"1-2-2-1-2-7\" data-name=\"activation status row\">\n                        <div class=\"flex items-center justify-between gap-3 text-[12px]\" data-kid=\"1-2-2-1-2-7-1\" data-name=\"activation status inner\">\n                            <span class=\"text-[#a8a8a8]\" data-kid=\"1-2-2-1-2-7-1-1\" data-name=\"activation status label\">\n                                حالة التفعيل\n                            </span>\n                            <span class=\"text-[#e4e4e4]\" data-kid=\"1-2-2-1-2-7-1-2\" data-name=\"activation status value\">\n                                بعد اعتماد الإيصال\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </aside>\n            <section class=\"order-2 min-w-0\" data-kid=\"1-2-2-2\" data-name=\"plans table section\">\n                <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"1-2-2-2-1\" data-name=\"plans table header\">\n                    <h2 class=\"m-0 text-[18px] font-semibold\" data-kid=\"1-2-2-2-1-1\" data-name=\"plans table title\">\n                        مقارنة الباقات\n                    </h2>\n                    <span class=\"text-[12px] text-[#a8a8a8]\" data-kid=\"1-2-2-2-1-2\" data-name=\"plans currency label\">\n                        الأسعار الشهرية · USD\n                    </span>\n                </div>\n                <div class=\"table-scroll overflow-x-auto\" data-kid=\"1-2-2-2-2\" data-name=\"scrollable table container\">\n                    <table class=\"w-full min-w-[760px] border-collapse text-right text-[13px] leading-6\" data-kid=\"1-2-2-2-2-1\" data-name=\"plans comparison table\">\n                        <thead data-kid=\"1-2-2-2-2-1-1\" data-name=\"table header row\">\n                            <tr class=\"border-b border-[#4a4a4a]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"header group\">\n                                <th class=\"w-[26%] px-4 py-4 text-[12px] font-medium text-[#a8a8a8]\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-name=\"table feature column header\" scope=\"col\">\n                                    تفاصيل الباقة\n                                </th>\n                                <th class=\"w-[24.7%] border-b-2 border-[#e50914] bg-[#141414] px-4 py-4 align-top\" data-kid=\"1-2-2-2-2-1-1-1-2\" data-name=\"plan column header 1\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer items-start gap-3\" data-kid=\"1-2-2-2-2-1-1-1-2-1\" data-name=\"plan radio input container\">\n                                        <input checked=\"\" class=\"mt-1 h-4 w-4 accent-[#e50914]\" data-kid=\"1-2-2-2-2-1-1-1-2-1-1\" data-name=\"radio input\" name=\"plan\" type=\"radio\"/>\n                                        <span class=\"block\" data-kid=\"1-2-2-2-2-1-1-1-2-1-2\" data-name=\"plan details\">\n                                            <span class=\"block text-[15px] font-bold text-white\" data-kid=\"1-2-2-2-2-1-1-1-2-1-2-1\" data-name=\"plan title\">\n                                                Basic Pass\n                                            </span>\n                                            <span class=\"latin mt-1 block text-[18px] font-semibold text-white\" data-kid=\"1-2-2-2-2-1-1-1-2-1-2-2\" data-name=\"plan price\" dir=\"ltr\">\n                                                $9.99\n                                                <small class=\"text-[11px] font-normal text-[#a8a8a8]\" data-kid=\"1-2-2-2-2-1-1-1-2-1-2-2-1\" data-name=\"price unit\">\n                                                    USD / month\n                                                </small>\n                                            </span>\n                                            <span class=\"mt-2 inline-block text-[11px] font-semibold text-[#ffffff]\" data-kid=\"1-2-2-2-2-1-1-1-2-1-2-3\" data-name=\"selected badge\">\n                                                محددة للمقارنة\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                                <th class=\"w-[24.7%] px-4 py-4 align-top\" data-kid=\"1-2-2-2-2-1-1-1-3\" data-name=\"plan column header 2\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer items-start gap-3\" data-kid=\"1-2-2-2-2-1-1-1-3-1\" data-name=\"plan radio input container\">\n                                        <input class=\"mt-1 h-4 w-4 accent-[#e50914]\" data-kid=\"1-2-2-2-2-1-1-1-3-1-1\" data-name=\"radio input\" name=\"plan\" type=\"radio\"/>\n                                        <span class=\"block\" data-kid=\"1-2-2-2-2-1-1-1-3-1-2\" data-name=\"plan details\">\n                                            <span class=\"block text-[15px] font-bold\" data-kid=\"1-2-2-2-2-1-1-1-3-1-2-1\" data-name=\"plan title\">\n                                                Standard Pro\n                                            </span>\n                                            <span class=\"latin mt-1 block text-[18px] font-semibold\" data-kid=\"1-2-2-2-2-1-1-1-3-1-2-2\" data-name=\"plan price\" dir=\"ltr\">\n                                                $19.99\n                                                <small class=\"text-[11px] font-normal text-[#a8a8a8]\" data-kid=\"1-2-2-2-2-1-1-1-3-1-2-2-1\" data-name=\"price unit\">\n                                                    USD / month\n                                                </small>\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                                <th class=\"w-[24.6%] px-4 py-4 align-top\" data-kid=\"1-2-2-2-2-1-1-1-4\" data-name=\"plan column header 3\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer items-start gap-3\" data-kid=\"1-2-2-2-2-1-1-1-4-1\" data-name=\"plan radio input container\">\n                                        <input class=\"mt-1 h-4 w-4 accent-[#e50914]\" data-kid=\"1-2-2-2-2-1-1-1-4-1-1\" data-name=\"radio input\" name=\"plan\" type=\"radio\"/>\n                                        <span class=\"block\" data-kid=\"1-2-2-2-2-1-1-1-4-1-2\" data-name=\"plan details\">\n                                            <span class=\"block text-[15px] font-bold\" data-kid=\"1-2-2-2-2-1-1-1-4-1-2-1\" data-name=\"plan title\">\n                                                VIP Ultra\n                                            </span>\n                                            <span class=\"latin mt-1 block text-[18px] font-semibold\" data-kid=\"1-2-2-2-2-1-1-1-4-1-2-2\" data-name=\"plan price\" dir=\"ltr\">\n                                                $29.99\n                                                <small class=\"text-[11px] font-normal text-[#a8a8a8]\" data-kid=\"1-2-2-2-2-1-1-1-4-1-2-2-1\" data-name=\"price unit\">\n                                                    USD / month\n                                                </small>\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-2-2-2-1-2\" data-name=\"table body\">\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"table row content access\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-1-1\" data-name=\"row header\" scope=\"row\">\n                                    الوصول للمحتوى\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-1-2\" data-name=\"cell 1\">\n                                    قنوات البث المباشر القياسية\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-1-3\" data-name=\"cell 2\">\n                                    الوصول الكامل إلى القنوات المباشرة ومكتبة الأفلام\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-1-4\" data-name=\"cell 3\">\n                                    وصول كامل إلى Live وVOD والمسلسلات\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"table row streaming quality\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-2-1\" data-name=\"row header\" scope=\"row\">\n                                    جودة البث\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-2-2\" data-name=\"cell 1\">\n                                    HD\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-2-3\" data-name=\"cell 2\">\n                                    FHD و4K\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-2-4\" data-name=\"cell 3\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-3\" data-name=\"table row downloads\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-3-1\" data-name=\"row header\" scope=\"row\">\n                                    تنزيلات الأفلام والمسلسلات\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-3-2\" data-name=\"cell 1\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-3-3\" data-name=\"cell 2\">\n                                    تنزيلات غير محدودة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-3-4\" data-name=\"cell 3\">\n                                    تنزيلات غير محدودة\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-4\" data-name=\"table row server integration\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-4-1\" data-name=\"row header\" scope=\"row\">\n                                    تكامل السيرفر الشخصي\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-4-2\" data-name=\"cell 1\">\n                                    مذكور ضمن مزايا الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-4-3\" data-name=\"cell 2\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-4-4\" data-name=\"cell 3\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-5\" data-name=\"table row devices\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-5-1\" data-name=\"row header\" scope=\"row\">\n                                    الأجهزة\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-5-2\" data-name=\"cell 1\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-5-3\" data-name=\"cell 2\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-5-4\" data-name=\"cell 3\">\n                                    دعم البث على عدة أجهزة\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#292929]\" data-kid=\"1-2-2-2-2-1-2-6\" data-name=\"table row support\">\n                                <th class=\"px-4 py-5 align-top font-medium text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-6-1\" data-name=\"row header\" scope=\"row\">\n                                    الدعم والخدمات\n                                </th>\n                                <td class=\"bg-[#141414] px-4 py-5 align-top text-[#777777]\" data-kid=\"1-2-2-2-2-1-2-6-2\" data-name=\"cell 1\">\n                                    غير محدد في بيانات الخطة\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-6-3\" data-name=\"cell 2\">\n                                    دعم ذو أولوية\n                                </td>\n                                <td class=\"px-4 py-5 align-top text-[#e4e4e4]\" data-kid=\"1-2-2-2-2-1-2-6-4\" data-name=\"cell 3\">\n                                    دعم مخصص 24/7\n                                    <br data-kid=\"1-2-2-2-2-1-2-6-4-1\" data-name=\"line break\"/>\n                                    ونسخ احتياطي لسيرفر IPTV\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"mt-5 flex items-start gap-3 border-t border-[#292929] pt-4 text-[12px] leading-6 text-[#a8a8a8]\" data-kid=\"1-2-2-2-3\" data-name=\"disclaimer section\">\n                    <i class=\"bi bi-info-circle mt-1 text-[14px]\" data-kid=\"1-2-2-2-3-1\" data-name=\"info icon\">\n                    </i>\n                    <p class=\"m-0\" data-kid=\"1-2-2-2-3-2\" data-name=\"disclaimer text\">\n                        «غير محدد في بيانات الخطة» تعني أن الميزة غير مذكورة ضمن تفاصيلها، ولا تعني أنها متاحة أو مستبعدة.\n                    </p>\n                </div>\n            </section>\n        </div>\n        <div class=\"mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-[#242424] pt-5 text-[12px] text-[#777777]\" data-kid=\"1-2-3\" data-name=\"footer branding section\">\n            <span data-kid=\"1-2-3-1\" data-name=\"footer note\">\n                تُراجع الإيصالات قبل تفعيل الاشتراك.\n            </span>\n            <span class=\"text-[#777777]\" data-kid=\"1-2-3-2\" data-name=\"footer metadata\">\n                الأسعار بالدولار الأمريكي · اشتراك شهري\n            </span>\n        </div>\n    </main>\n</div>\n",
