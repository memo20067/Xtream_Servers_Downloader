      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n.xtream-payment { font-family: 'Noto Sans Arabic', 'Inter', sans-serif; background:#000; color:#fff; min-height:100vh; }\n.xtream-payment .muted { color:#a8a8a8; }\n.xtream-payment .dim { color:#808080; }\n.xtream-payment .rule { border-color:#333; }\n.xtream-payment .surface { background:#141414; }\n.xtream-payment .raised { background:#181818; }\n.xtream-payment .accent { color:#e50914; }\n.xtream-payment .accent-bg { background:#e50914; }\n.xtream-payment .plan-radio { accent-color:#e50914; }\n.xtream-payment .plan-column { border-inline-start:1px solid #333; }\n.xtream-payment .plan-column:last-child { border-inline-start:0; }\n.xtream-payment .chosen-column { background:#181818; box-shadow:inset 0 0 0 1px #e50914; }\n.xtream-payment .input-shell { background:#0a0a0a; border:1px solid #333; color:#fff; }\n.xtream-payment .input-shell:focus-within { border-color:#e50914; }\n.xtream-payment .upload-shell { border:1px dashed #555; background:#0a0a0a; }\n.xtream-payment .soft-rule { border-color:#242424; }\n.xtream-payment .step-line { height:1px; background:#333; }\n.xtream-payment .download-context { border-inline-start:3px solid #e50914; }\n@media (max-width: 1000px) {\n  .xtream-payment .page-grid { grid-template-columns:1fr; }\n  .xtream-payment .summary-panel { grid-row:1; }\n  .xtream-payment .plan-table { min-width:730px; }\n  .xtream-payment .table-scroll { overflow-x:auto; }\n}\n@media (max-width: 620px) {\n  .xtream-payment .content-wrap { padding-left:20px; padding-right:20px; }\n  .xtream-payment .brand-caption { display:none; }\n  .xtream-payment .step-label { display:none; }\n  .xtream-payment .stepper { justify-content:space-between; }\n}\n</style>\n<div class=\"xtream-payment\" data-kid=\"1\" dir=\"rtl\" lang=\"ar\">\n    <header class=\"border-b border-[#333] bg-black\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1320px] items-center justify-between px-8 max-[620px]:px-5\" data-kid=\"1-1-1\">\n            <a class=\"flex items-center gap-3 text-white no-underline\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#e50914] text-[20px] font-extrabold leading-none\" data-kid=\"1-1-1-1-1\">\n                    X\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"text-[19px] font-extrabold tracking-[.04em]\" data-kid=\"1-1-1-1-2-1\">\n                        XTREAM\n                    </span>\n                    <span class=\"brand-caption mt-1 text-[11px] tracking-[.1em] text-[#808080]\" data-kid=\"1-1-1-1-2-2\">\n                        LIVE · MOVIES · SERIES\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-7\" data-kid=\"1-1-1-2\">\n                <span class=\"text-sm text-[#a8a8a8]\" data-kid=\"1-1-1-2-1\">\n                    مرحبًا،\n                    <b class=\"font-semibold text-white\" data-kid=\"1-1-1-2-1-1\">\n                        مشاهد\n                    </b>\n                </span>\n                <a class=\"flex items-center gap-2 text-sm text-[#a8a8a8] no-underline hover:text-white\" data-kid=\"1-1-1-2-2\" href=\"#\">\n                    <i class=\"bi bi-arrow-right\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                    <span class=\"max-[620px]:hidden\" data-kid=\"1-1-1-2-2-2\">\n                        العودة إلى المكتبة\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"content-wrap mx-auto max-w-[1320px] px-8 pb-16 pt-8 max-[620px]:pt-6\" data-kid=\"1-2\">\n        <nav aria-label=\"خطوات الاشتراك\" class=\"stepper mb-9 flex items-center justify-center gap-5\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#e50914] text-sm font-bold text-white\" data-kid=\"1-2-1-1-1\">\n                    ١\n                </span>\n                <span class=\"step-label text-sm font-semibold text-white\" data-kid=\"1-2-1-1-2\">\n                    اختر الباقة\n                </span>\n            </div>\n            <span class=\"step-line w-16\" data-kid=\"1-2-1-2\">\n            </span>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#444] bg-[#141414] text-sm font-semibold text-[#a8a8a8]\" data-kid=\"1-2-1-3-1\">\n                    ٢\n                </span>\n                <span class=\"step-label text-sm text-[#808080]\" data-kid=\"1-2-1-3-2\">\n                    سجّل طريقة الدفع\n                </span>\n            </div>\n            <span class=\"step-line w-16\" data-kid=\"1-2-1-4\">\n            </span>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-5\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#444] bg-[#141414] text-sm font-semibold text-[#a8a8a8]\" data-kid=\"1-2-1-5-1\">\n                    ٣\n                </span>\n                <span class=\"step-label text-sm text-[#808080]\" data-kid=\"1-2-1-5-2\">\n                    ارفع الإيصال\n                </span>\n            </div>\n        </nav>\n        <section class=\"mb-7\" data-kid=\"1-2-2\">\n            <h1 class=\"mb-2 text-[32px] font-bold leading-tight tracking-[-.03em] max-[620px]:text-[26px]\" data-kid=\"1-2-2-1\">\n                أكمل تنزيل الفيلم الذي اخترته\n            </h1>\n            <p class=\"mb-0 max-w-[820px] text-[15px] leading-7 text-[#a8a8a8]\" data-kid=\"1-2-2-2\">\n                يتطلب تنزيل الأفلام والمسلسلات اشتراكًا مدفوعًا. قارن مزايا الباقات، ثم اختر طريقة الدفع وارفع الإيصال لمراجعته.\n            </p>\n        </section>\n        <section class=\"download-context mb-8 flex items-start gap-4 bg-[#141414] px-5 py-4\" data-kid=\"1-2-3\">\n            <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[4px] bg-[#1b1011] text-[18px] text-[#e50914]\" data-kid=\"1-2-3-1\">\n                <i class=\"bi bi-download\" data-kid=\"1-2-3-1-1\">\n                </i>\n            </span>\n            <div data-kid=\"1-2-3-2\">\n                <h2 class=\"mb-1 text-[15px] font-bold\" data-kid=\"1-2-3-2-1\">\n                    التنزيل يتطلب اشتراكًا مدفوعًا\n                </h2>\n                <p class=\"mb-0 text-[13px] leading-6 text-[#a8a8a8]\" data-kid=\"1-2-3-2-2\">\n                    الفيلم الذي اخترته بانتظار اشتراكك. اختر إحدى الباقات أدناه لمتابعة إرسال إيصال الدفع.\n                </p>\n            </div>\n        </section>\n        <div class=\"page-grid grid grid-cols-[minmax(0,1fr)_360px] items-start gap-7 max-[1000px]:grid-cols-1\" data-kid=\"1-2-4\">\n            <section class=\"min-w-0\" data-kid=\"1-2-4-1\">\n                <div class=\"mb-4 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <h2 class=\"mb-1 text-[22px] font-bold\" data-kid=\"1-2-4-1-1-1-1\">\n                            قارن الباقات واختر اشتراكك\n                        </h2>\n                        <p class=\"mb-0 text-[13px] text-[#808080]\" data-kid=\"1-2-4-1-1-1-2\">\n                            المزايا المعروضة هي الواردة في وصف كل باقة.\n                        </p>\n                    </div>\n                    <span class=\"flex items-center gap-2 text-xs text-[#a8a8a8]\" data-kid=\"1-2-4-1-1-2\">\n                        <i class=\"bi bi-info-circle text-[#808080]\" data-kid=\"1-2-4-1-1-2-1\">\n                        </i>\n                        الأسعار بالدولار الأمريكي\n                    </span>\n                </div>\n                <div class=\"table-scroll overflow-hidden rounded-[4px] border border-[#333] bg-[#0b0b0b]\" data-kid=\"1-2-4-1-2\">\n                    <table class=\"plan-table w-full table-fixed border-collapse text-right\" data-kid=\"1-2-4-1-2-1\">\n                        <thead data-kid=\"1-2-4-1-2-1-1\">\n                            <tr class=\"border-b border-[#333]\" data-kid=\"1-2-4-1-2-1-1-1\">\n                                <th class=\"w-[155px] px-4 py-5 align-bottom text-[13px] font-medium text-[#808080]\" data-kid=\"1-2-4-1-2-1-1-1-1\" scope=\"col\">\n                                    مزايا الباقة\n                                </th>\n                                <th class=\"plan-column px-5 py-5 align-top\" data-kid=\"1-2-4-1-2-1-1-1-2\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer flex-col gap-3\" data-kid=\"1-2-4-1-2-1-1-1-2-1\" for=\"plan-basic\">\n                                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-4-1-2-1-1-1-2-1-1\">\n                                            <span class=\"text-[17px] font-bold text-white\" data-kid=\"1-2-4-1-2-1-1-1-2-1-1-1\">\n                                                Basic Pass\n                                            </span>\n                                            <input class=\"plan-radio h-[17px] w-[17px] cursor-pointer\" data-benefit=\"قنوات بث مباشر قياسية · بث HD · تكامل الخادم الشخصي\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-1-1-1-2-1-1-2\" data-name=\"plan choice radio button\" data-price=\"9.99\" data-reason=\"visual/state driven by JavaScript based on user selection\" id=\"plan-basic\" name=\"plan-choice\" type=\"radio\" value=\"Basic Pass\"/>\n                                        </span>\n                                        <span class=\"flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-1-1-1-2-1-2\" dir=\"ltr\">\n                                            <span class=\"text-[25px] font-bold tracking-tight text-white\" data-kid=\"1-2-4-1-2-1-1-1-2-1-2-1\">\n                                                $9.99\n                                            </span>\n                                            <span class=\"text-xs text-[#808080]\" data-kid=\"1-2-4-1-2-1-1-1-2-1-2-2\">\n                                                USD\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                                <th class=\"plan-column chosen-column px-5 py-5 align-top\" data-kid=\"1-2-4-1-2-1-1-1-3\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer flex-col gap-3\" data-kid=\"1-2-4-1-2-1-1-1-3-1\" for=\"plan-standard\">\n                                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-4-1-2-1-1-1-3-1-1\">\n                                            <span class=\"text-[17px] font-bold text-white\" data-kid=\"1-2-4-1-2-1-1-1-3-1-1-1\">\n                                                Standard Pro\n                                            </span>\n                                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-2-1-1-1-3-1-1-2\">\n                                                <span class=\"rounded-[2px] bg-[#e50914] px-2 py-1 text-[10px] font-semibold text-white\" data-kid=\"1-2-4-1-2-1-1-1-3-1-1-2-1\">\n                                                    مختارة\n                                                </span>\n                                                <input checked=\"\" class=\"plan-radio h-[17px] w-[17px] cursor-pointer\" data-benefit=\"مكتبة بث مباشر وأفلام · بث FHD و4K · تنزيلات غير محدودة للأفلام والمسلسلات · دعم بأولوية\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-1-1-1-3-1-1-2-2\" data-name=\"plan choice radio button\" data-price=\"19.99\" data-reason=\"visual/state driven by JavaScript based on user selection\" id=\"plan-standard\" name=\"plan-choice\" type=\"radio\" value=\"Standard Pro\"/>\n                                            </span>\n                                        </span>\n                                        <span class=\"flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-1-1-1-3-1-2\" dir=\"ltr\">\n                                            <span class=\"text-[25px] font-bold tracking-tight text-white\" data-kid=\"1-2-4-1-2-1-1-1-3-1-2-1\">\n                                                $19.99\n                                            </span>\n                                            <span class=\"text-xs text-[#808080]\" data-kid=\"1-2-4-1-2-1-1-1-3-1-2-2\">\n                                                USD\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                                <th class=\"plan-column px-5 py-5 align-top\" data-kid=\"1-2-4-1-2-1-1-1-4\" scope=\"col\">\n                                    <label class=\"flex cursor-pointer flex-col gap-3\" data-kid=\"1-2-4-1-2-1-1-1-4-1\" for=\"plan-vip\">\n                                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-4-1-2-1-1-1-4-1-1\">\n                                            <span class=\"text-[17px] font-bold text-white\" data-kid=\"1-2-4-1-2-1-1-1-4-1-1-1\">\n                                                VIP Ultra\n                                            </span>\n                                            <input class=\"plan-radio h-[17px] w-[17px] cursor-pointer\" data-benefit=\"وصول VIP للبث المباشر وVOD والمسلسلات · عدة أجهزة · تنزيلات غير محدودة · دعم 24/7 ونسخة احتياطية للخادم\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-1-1-1-4-1-1-2\" data-name=\"plan choice radio button\" data-price=\"29.99\" data-reason=\"visual/state driven by JavaScript based on user selection\" id=\"plan-vip\" name=\"plan-choice\" type=\"radio\" value=\"VIP Ultra\"/>\n                                        </span>\n                                        <span class=\"flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-1-1-1-4-1-2\" dir=\"ltr\">\n                                            <span class=\"text-[25px] font-bold tracking-tight text-white\" data-kid=\"1-2-4-1-2-1-1-1-4-1-2-1\">\n                                                $29.99\n                                            </span>\n                                            <span class=\"text-xs text-[#808080]\" data-kid=\"1-2-4-1-2-1-1-1-4-1-2-2\">\n                                                USD\n                                            </span>\n                                        </span>\n                                    </label>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-4-1-2-1-2\">\n                            <tr class=\"border-b border-[#333]\" data-kid=\"1-2-4-1-2-1-2-1\">\n                                <th class=\"px-4 py-5 align-top text-[13px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-4-1-2-1-2-1-1\" scope=\"row\">\n                                    الوصول إلى المحتوى\n                                </th>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-1-2\">\n                                    الوصول إلى قنوات البث المباشر القياسية\n                                </td>\n                                <td class=\"plan-column chosen-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-1-3\">\n                                    مكتبة البث المباشر والأفلام كاملة\n                                </td>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-1-4\">\n                                    وصول VIP كامل إلى البث المباشر والفيديو عند الطلب والمسلسلات\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#333]\" data-kid=\"1-2-4-1-2-1-2-2\">\n                                <th class=\"px-4 py-5 align-top text-[13px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-4-1-2-1-2-2-1\" scope=\"row\">\n                                    جودة البث\n                                </th>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-2-2\">\n                                    بث بجودة HD\n                                </td>\n                                <td class=\"plan-column chosen-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-2-3\">\n                                    بث بدقتي FHD و4K\n                                </td>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#808080]\" data-kid=\"1-2-4-1-2-1-2-2-4\">\n                                    غير مذكور في وصف الباقة\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#333]\" data-kid=\"1-2-4-1-2-1-2-3\">\n                                <th class=\"px-4 py-5 align-top text-[13px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-4-1-2-1-2-3-1\" scope=\"row\">\n                                    تنزيل الأفلام والمسلسلات\n                                </th>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#808080]\" data-kid=\"1-2-4-1-2-1-2-3-2\">\n                                    غير مذكور في وصف الباقة\n                                </td>\n                                <td class=\"plan-column chosen-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-3-3\">\n                                    تنزيلات غير محدودة للأفلام والمسلسلات\n                                </td>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-3-4\">\n                                    تنزيلات غير محدودة للأفلام والمسلسلات\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-4-1-2-1-2-4\">\n                                <th class=\"px-4 py-5 align-top text-[13px] font-semibold text-[#a8a8a8]\" data-kid=\"1-2-4-1-2-1-2-4-1\" scope=\"row\">\n                                    مزايا إضافية\n                                </th>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-4-2\">\n                                    تكامل الخادم الشخصي\n                                </td>\n                                <td class=\"plan-column chosen-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-4-3\">\n                                    دعم بأولوية\n                                </td>\n                                <td class=\"plan-column px-5 py-5 align-top text-[13px] leading-6 text-[#f5f5f5]\" data-kid=\"1-2-4-1-2-1-2-4-4\">\n                                    البث على عدة أجهزة · دعم مخصص 24/7 · نسخة احتياطية لخادم IPTV\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <p class=\"mt-3 text-[11px] leading-5 text-[#808080]\" data-kid=\"1-2-4-1-3\">\n                    عبارة «غير مذكور في وصف الباقة» تعني أن هذه الميزة غير واردة في القائمة الحالية، ولا تفترض غيابها من الخدمة.\n                </p>\n            </section>\n            <aside class=\"summary-panel surface rounded-[4px] p-5\" data-kid=\"1-2-4-2\">\n                <div class=\"mb-5 flex items-center justify-between border-b border-[#333] pb-4\" data-kid=\"1-2-4-2-1\">\n                    <div data-kid=\"1-2-4-2-1-1\">\n                        <h2 class=\"mb-1 text-[18px] font-bold\" data-kid=\"1-2-4-2-1-1-1\">\n                            ملخص اختيارك\n                        </h2>\n                        <p class=\"mb-0 text-xs text-[#808080]\" data-kid=\"1-2-4-2-1-1-2\">\n                            تأكد من الباقة قبل إرسال الإيصال\n                        </p>\n                    </div>\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#1c1112] text-[#e50914]\" data-kid=\"1-2-4-2-1-2\">\n                        <i class=\"bi bi-receipt text-lg\" data-kid=\"1-2-4-2-1-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"mb-5 flex items-start justify-between gap-3\" data-kid=\"1-2-4-2-2\">\n                    <div data-kid=\"1-2-4-2-2-1\">\n                        <p class=\"mb-1 text-xs text-[#808080]\" data-kid=\"1-2-4-2-2-1-1\">\n                            الباقة المحددة\n                        </p>\n                        <p class=\"mb-0 text-[18px] font-bold\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"selected plan name\" data-reason=\"text updated by script when plan selection changes\" id=\"selected-plan-name\">\n                            Standard Pro\n                        </p>\n                    </div>\n                    <div class=\"text-left\" data-kid=\"1-2-4-2-2-2\" dir=\"ltr\">\n                        <p class=\"mb-1 text-xs text-[#808080]\" data-kid=\"1-2-4-2-2-2-1\">\n                            السعر\n                        </p>\n                        <p class=\"mb-0 text-[19px] font-bold\" data-kid=\"1-2-4-2-2-2-2\">\n                            <span data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-2-1\" data-name=\"selected plan price\" data-reason=\"text updated by script when plan selection changes\" id=\"selected-plan-price\">\n                                $19.99\n                            </span>\n                            <span class=\"text-[11px] font-medium text-[#a8a8a8]\" data-kid=\"1-2-4-2-2-2-2-2\">\n                                USD\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mb-6 border-b border-[#333] pb-5 text-[12px] leading-6 text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-2-4-2-3\" data-name=\"selected plan benefits list\" data-reason=\"text updated by script when plan selection changes\" id=\"selected-plan-benefit\">\n                    مكتبة بث مباشر وأفلام · بث FHD و4K · تنزيلات غير محدودة للأفلام والمسلسلات · دعم بأولوية\n                </p>\n                <form class=\"flex flex-col gap-4\" data-kid=\"1-2-4-2-4\">\n                    <fieldset data-kid=\"1-2-4-2-4-1\">\n                        <legend class=\"mb-2 text-[13px] font-semibold\" data-kid=\"1-2-4-2-4-1-1\">\n                            طريقة الدفع\n                        </legend>\n                        <label class=\"sr-only\" data-kid=\"1-2-4-2-4-1-2\" for=\"payment-method\">\n                            اختر طريقة الدفع\n                        </label>\n                        <div class=\"input-shell flex h-11 items-center justify-between rounded-[4px] px-3 text-[13px] text-[#808080]\" data-kid=\"1-2-4-2-4-1-3\">\n                            <select class=\"w-full appearance-none bg-transparent text-[13px] text-[#a8a8a8] outline-none\" data-kid=\"1-2-4-2-4-1-3-1\" id=\"payment-method\">\n                                <option data-kid=\"1-2-4-2-4-1-3-1-1\" selected=\"\">\n                                    اختر طريقة الدفع المعتمدة\n                                </option>\n                            </select>\n                            <i class=\"bi bi-chevron-down text-[11px] text-[#808080]\" data-kid=\"1-2-4-2-4-1-3-2\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 mb-0 text-[11px] text-[#808080]\" data-kid=\"1-2-4-2-4-1-4\">\n                            تظهر طرق الدفع التي أضافها مسؤول النظام.\n                        </p>\n                    </fieldset>\n                    <div data-kid=\"1-2-4-2-4-2\">\n                        <label class=\"mb-2 block text-[13px] font-semibold\" data-kid=\"1-2-4-2-4-2-1\" for=\"amount\">\n                            المبلغ المدفوع\n                        </label>\n                        <div class=\"input-shell flex h-11 items-center gap-2 rounded-[4px] px-3\" data-kid=\"1-2-4-2-4-2-2\" dir=\"ltr\">\n                            <span class=\"text-[13px] text-[#808080]\" data-kid=\"1-2-4-2-4-2-2-1\">\n                                USD\n                            </span>\n                            <input class=\"w-full bg-transparent text-[13px] text-white outline-none placeholder:text-[#666]\" data-kid=\"1-2-4-2-4-2-2-2\" id=\"amount\" inputmode=\"decimal\" placeholder=\"19.99\" type=\"text\"/>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-4-2-4-3\">\n                        <label class=\"mb-2 block text-[13px] font-semibold\" data-kid=\"1-2-4-2-4-3-1\" for=\"transaction-id\">\n                            رقم المعاملة\n                            <span class=\"font-normal text-[#808080]\" data-kid=\"1-2-4-2-4-3-1-1\">\n                                (اختياري)\n                            </span>\n                        </label>\n                        <input class=\"input-shell h-11 w-full rounded-[4px] px-3 text-[13px] outline-none placeholder:text-[#666]\" data-kid=\"1-2-4-2-4-3-2\" id=\"transaction-id\" placeholder=\"أدخل الرقم إن وجد\" type=\"text\"/>\n                    </div>\n                    <div data-kid=\"1-2-4-2-4-4\">\n                        <label class=\"mb-2 block text-[13px] font-semibold\" data-kid=\"1-2-4-2-4-4-1\" for=\"receipt\">\n                            إيصال الدفع\n                        </label>\n                        <label class=\"upload-shell flex min-h-[102px] cursor-pointer flex-col items-center justify-center rounded-[4px] px-3 py-4 text-center\" data-kid=\"1-2-4-2-4-4-2\" for=\"receipt\">\n                            <i class=\"bi bi-cloud-arrow-up mb-2 text-[22px] text-[#a8a8a8]\" data-kid=\"1-2-4-2-4-4-2-1\">\n                            </i>\n                            <span class=\"text-[13px] font-semibold\" data-kid=\"1-2-4-2-4-4-2-2\">\n                                اختر صورة الإيصال أو ملف PDF\n                            </span>\n                            <span class=\"mt-1 text-[11px] text-[#808080]\" data-kid=\"1-2-4-2-4-4-2-3\">\n                                JPG · PNG · GIF · WEBP · PDF\n                            </span>\n                            <input accept=\"image/*,.pdf\" class=\"sr-only\" data-kid=\"1-2-4-2-4-4-2-4\" id=\"receipt\" type=\"file\"/>\n                        </label>\n                    </div>\n                    <button class=\"accent-bg mt-1 flex h-[48px] w-full items-center justify-center gap-2 rounded-[4px] px-4 text-[14px] font-bold text-white\" data-kid=\"1-2-4-2-4-5\" type=\"button\">\n                        <i class=\"bi bi-upload\" data-kid=\"1-2-4-2-4-5-1\">\n                        </i>\n                        رفع إيصال الدفع\n                    </button>\n                    <p class=\"mb-0 text-center text-[11px] leading-5 text-[#808080]\" data-kid=\"1-2-4-2-4-6\">\n                        بعد الإرسال، يظهر الإيصال «قيد المراجعة» حتى يتحقق منه المسؤول.\n                    </p>\n                </form>\n            </aside>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n  const radios = document.querySelectorAll('.plan-radio');\n  const name = document.getElementById('selected-plan-name');\n  const price = document.getElementById('selected-plan-price');\n  const benefit = document.getElementById('selected-plan-benefit');\n  const columns = document.querySelectorAll('.plan-column');\n\n  function syncPlan(radio) {\n    name.textContent = radio.value;\n    price.textContent = '$' + Number(radio.dataset.price).toFixed(2);\n    benefit.textContent = radio.dataset.benefit;\n    columns.forEach(column => column.classList.remove('chosen-column'));\n    const cellIndex = Array.from(radio.closest('tr').children).indexOf(radio.closest('th,td'));\n    document.querySelectorAll('.plan-table tr').forEach(row => {\n      const cell = row.children[cellIndex];\n      if (cell) cell.classList.add('chosen-column');\n    });\n  }\n  radios.forEach(radio => radio.addEventListener('change', () => syncPlan(radio)));\n})();\n</script>\n",
