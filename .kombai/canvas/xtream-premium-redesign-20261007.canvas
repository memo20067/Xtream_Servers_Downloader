      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n.auth-page { font-family: 'Noto Sans Arabic', 'Inter', system-ui, sans-serif; }\n.auth-input { width: 100%; height: 54px; background: #0a0a0a; border: 1px solid #333; border-radius: 4px; padding: 0 16px; color: #fff; outline: none; transition: border-color 150ms ease; }\n.auth-input:focus { border-color: #e50914; }\n.auth-input::placeholder { color: #777; }\n@media (max-width: 760px) { .auth-shell { grid-template-columns: 1fr; } .brand-panel { display: none; } .auth-page { min-height: 100svh; } }\n</style>\n<div class=\"auth-page min-h-screen bg-[#000000] text-white\" data-kid=\"1\" data-name=\"authentication page container\" dir=\"rtl\" lang=\"ar\">\n    <div class=\"mx-auto flex min-h-screen w-full max-w-[1180px] flex-col px-6 py-6 md:px-10 md:py-7\" data-kid=\"1-1\" data-name=\"page layout wrapper\">\n        <header class=\"flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header navigation section\">\n            <a class=\"flex items-center gap-3 text-white no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"index.php\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-[4px] bg-[#e50914] text-lg text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i aria-hidden=\"true\" class=\"bi bi-broadcast\" data-kid=\"1-1-1-1-1-1\" data-name=\"broadcast icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand name container\">\n                    <span class=\"text-[17px] font-bold tracking-[0.08em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title text\">\n                        XTREAM\n                    </span>\n                    <span class=\"mt-1 text-[10px] tracking-[0.18em] text-[#8a8a8a]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        IPTV PLAYER\n                    </span>\n                </span>\n            </a>\n            <a class=\"text-[13px] font-medium text-[#b3b3b3] underline-offset-4 hover:text-white hover:underline\" data-kid=\"1-1-1-2\" data-name=\"language switcher link\" href=\"?lang=en\" id=\"language-toggle\">\n                <span data-dynamic=\"true\" data-kid=\"1-1-1-2-2\" data-name=\"language name text\" data-reason=\"text replaced by locale switching script\" id=\"language-label\">\n                    English\n                </span>\n                <span aria-hidden=\"true\" data-kid=\"1-1-1-2-1\" data-name=\"language switcher arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </header>\n        <main class=\"flex flex-1 items-center justify-center py-12 md:py-16\" data-kid=\"1-1-2\" data-name=\"main authentication content section\">\n            <div class=\"auth-shell grid w-full max-w-[1000px] grid-cols-1 overflow-hidden rounded-[8px] border border-[#2f2f2f] bg-[#141414] md:grid-cols-[1fr_1fr]\" data-kid=\"1-1-2-1\" data-name=\"login card container\">\n                <aside class=\"brand-panel flex min-h-[570px] flex-col justify-between border-l border-[#2f2f2f] bg-[#101010] p-10 lg:p-14\" data-kid=\"1-1-2-1-1\" data-name=\"brand marketing side panel\">\n                    <div data-kid=\"1-1-2-1-1-1\" data-name=\"marketing text container\">\n                        <div class=\"mb-12 flex items-center gap-2 text-[12px] font-semibold text-[#d1d1d1]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"status indicator container\">\n                            <span class=\"relative flex h-2 w-2\" data-kid=\"1-1-2-1-1-1-1-1\" data-name=\"pulse animation container\">\n                                <span class=\"absolute inline-flex h-full w-full rounded-full bg-[#e50914] opacity-70\" data-kid=\"1-1-2-1-1-1-1-1-1\" data-name=\"pulse circle background\">\n                                </span>\n                                <span class=\"relative inline-flex h-2 w-2 rounded-full bg-[#e50914]\" data-kid=\"1-1-2-1-1-1-1-1-2\" data-name=\"pulse circle foreground\">\n                                </span>\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"status label text\" data-reason=\"text replaced by locale switching script\">\n                                منصة مشاهدة واحدة\n                            </span>\n                        </div>\n                        <h1 class=\"m-0 max-w-[390px] text-[38px] font-bold leading-[1.35] tracking-[-0.035em] lg:text-[44px]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"marketing headline text\" data-reason=\"text replaced by locale switching script\">\n                            قنواتك، أفلامك،\n                            <br data-kid=\"1-1-2-1-1-1-2-1\" data-name=\"headline line break\"/>\n                            <span class=\"text-[#a8a8a8]\" data-kid=\"1-1-2-1-1-1-2-2\" data-name=\"highlighted headline text\">\n                                ومسلسلاتك.\n                            </span>\n                        </h1>\n                        <p class=\"mt-5 max-w-[340px] text-[15px] leading-7 text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1-3\" data-name=\"marketing description text\" data-reason=\"text replaced by locale switching script\">\n                            تابع المشاهدة من مساحة تجمع البث المباشر ومكتبة الترفيه.\n                        </p>\n                    </div>\n                    <div class=\"space-y-5\" data-kid=\"1-1-2-1-1-2\" data-name=\"marketing features container\">\n                        <div class=\"h-px w-full bg-[#2f2f2f]\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"divider line\">\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-x-6 gap-y-3 text-[13px] font-medium text-[#c4c4c4]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"features list container\">\n                            <span class=\"inline-flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"live broadcast feature item\" data-reason=\"text content appended by locale switching script\">\n                                <i aria-hidden=\"true\" class=\"bi bi-broadcast text-[#a8a8a8]\" data-kid=\"1-1-2-1-1-2-2-1-1\" data-name=\"live broadcast icon\">\n                                </i>\n                                البث المباشر\n                            </span>\n                            <span class=\"inline-flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-2-2\" data-name=\"movies feature item\" data-reason=\"text content appended by locale switching script\">\n                                <i aria-hidden=\"true\" class=\"bi bi-film text-[#a8a8a8]\" data-kid=\"1-1-2-1-1-2-2-2-1\" data-name=\"movies icon\">\n                                </i>\n                                الأفلام\n                            </span>\n                            <span class=\"inline-flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-2-3\" data-name=\"series feature item\" data-reason=\"text content appended by locale switching script\">\n                                <i aria-hidden=\"true\" class=\"bi bi-collection-play text-[#a8a8a8]\" data-kid=\"1-1-2-1-1-2-2-3-1\" data-name=\"series icon\">\n                                </i>\n                                المسلسلات\n                            </span>\n                        </div>\n                    </div>\n                </aside>\n                <section class=\"flex flex-col justify-center px-7 py-10 sm:px-12 lg:px-14\" data-kid=\"1-1-2-1-2\" data-name=\"login form section\">\n                    <div class=\"mb-9\" data-kid=\"1-1-2-1-2-1\" data-name=\"form header container\">\n                        <h2 class=\"m-0 text-[29px] font-bold tracking-[-0.025em]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"login title text\" data-reason=\"text replaced by locale switching script\">\n                            تسجيل الدخول\n                        </h2>\n                        <p class=\"mb-0 mt-2 text-[14px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"login subtitle text\" data-reason=\"text replaced by locale switching script\">\n                            أدخل بيانات حسابك للمتابعة.\n                        </p>\n                    </div>\n                    <form action=\"login.php\" class=\"space-y-6\" data-kid=\"1-1-2-1-2-2\" data-name=\"login input form\" method=\"post\">\n                        <div data-kid=\"1-1-2-1-2-2-1\" data-name=\"username field container\">\n                            <label class=\"mb-2 block text-[13px] font-medium text-[#e7e7e7]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"username label\" data-reason=\"text replaced by locale switching script\" for=\"username\">\n                                اسم المستخدم أو البريد الإلكتروني\n                            </label>\n                            <input autocomplete=\"username\" class=\"auth-input\" data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"username input field\" id=\"username\" name=\"username\" required=\"\" type=\"text\"/>\n                        </div>\n                        <div data-kid=\"1-1-2-1-2-2-2\" data-name=\"password field container\">\n                            <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"password header container\">\n                                <label class=\"block text-[13px] font-medium text-[#e7e7e7]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1-1\" data-name=\"password label\" data-reason=\"text replaced by locale switching script\" for=\"password\">\n                                    كلمة المرور\n                                </label>\n                                <a class=\"shrink-0 text-[12px] text-[#b3b3b3] underline-offset-4 hover:text-white hover:underline\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1-2\" data-name=\"forgot password link\" data-reason=\"text replaced by locale switching script\" href=\"forgot_password.php\">\n                                    نسيت كلمة المرور؟\n                                </a>\n                            </div>\n                            <input autocomplete=\"current-password\" class=\"auth-input\" data-kid=\"1-1-2-1-2-2-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" required=\"\" type=\"password\"/>\n                        </div>\n                        <button class=\"flex h-[52px] w-full items-center justify-center gap-2 rounded-[4px] bg-[#e50914] px-5 text-[15px] font-bold text-white transition-colors hover:bg-[#b20710] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e50914]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"login submit button\" data-reason=\"content replaced by locale switching script\" type=\"submit\">\n                            تسجيل الدخول\n                            <i aria-hidden=\"true\" class=\"bi bi-arrow-left\" data-kid=\"1-1-2-1-2-2-3-1\" data-name=\"arrow icon\">\n                            </i>\n                        </button>\n                    </form>\n                    <div class=\"mt-7 border-t border-[#2f2f2f] pt-6 text-[13px] text-[#a8a8a8]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-3\" data-name=\"register link container\" data-reason=\"content replaced by locale switching script\">\n                        ليس لديك حساب؟\n                        <a class=\"font-semibold text-white underline underline-offset-4\" data-kid=\"1-1-2-1-2-3-1\" data-name=\"register link\" href=\"register.php\">\n                            إنشاء حساب\n                        </a>\n                    </div>\n                </section>\n            </div>\n        </main>\n        <footer class=\"flex items-center justify-between border-t border-[#2f2f2f] py-4 text-[11px] text-[#777]\" data-kid=\"1-1-3\" data-name=\"footer section\">\n            <span data-kid=\"1-1-3-1\" data-name=\"footer brand name\">\n                XTREAM IPTV\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-1-3-2\" data-name=\"footer service features text\" data-reason=\"text replaced by locale switching script\">\n                البث المباشر · الأفلام · المسلسلات\n            </span>\n        </footer>\n    </div>\n</div>\n<script>\n    (() => {\n  const toggle = document.getElementById('language-toggle');\n  const root = document.querySelector('.auth-page');\n  const copy = {\n    ar: {\n      status: 'منصة مشاهدة واحدة', headline: 'قنواتك، أفلامك،<br><span class=\"text-[#a8a8a8]\">ومسلسلاتك.</span>',\n      intro: 'تابع المشاهدة من مساحة تجمع البث المباشر ومكتبة الترفيه.',\n      live: 'البث المباشر', movies: 'الأفلام', series: 'المسلسلات',\n      title: 'تسجيل الدخول', subtitle: 'أدخل بيانات حسابك للمتابعة.',\n      username: 'اسم المستخدم أو البريد الإلكتروني', password: 'كلمة المرور',\n      forgot: 'نسيت كلمة المرور؟', submit: 'تسجيل الدخول',\n      signup: 'ليس لديك حساب؟', create: 'إنشاء حساب', language: 'English',\n      footer: 'البث المباشر · الأفلام · المسلسلات'\n    },\n    en: {\n      status: 'One place to watch', headline: 'Channels, films,<br><span class=\"text-[#a8a8a8]\">and series.</span>',\n      intro: 'Watch live TV and explore your entertainment library.',\n      live: 'Live TV', movies: 'Movies', series: 'Series',\n      title: 'Sign in', subtitle: 'Enter your account details to continue.',\n      username: 'Username or email', password: 'Password',\n      forgot: 'Forgot password?', submit: 'Sign in',\n      signup: 'No account yet?', create: 'Create an account', language: 'العربية',\n      footer: 'Live TV · Movies · Series'\n    }\n  };\n  const setLanguage = (lang) => {\n    const text = copy[lang];\n    document.documentElement.lang = lang;\n    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';\n    root.dir = lang === 'ar' ? 'rtl' : 'ltr';\n    document.querySelector('[data-name=\"status label text\"]').textContent = text.status;\n    document.querySelector('[data-name=\"marketing headline text\"]').innerHTML = text.headline;\n    document.querySelector('[data-name=\"marketing description text\"]').textContent = text.intro;\n    document.querySelector('[data-name=\"live broadcast feature item\"]').lastChild.textContent = ' ' + text.live;\n    document.querySelector('[data-name=\"movies feature item\"]').lastChild.textContent = ' ' + text.movies;\n    document.querySelector('[data-name=\"series feature item\"]').lastChild.textContent = ' ' + text.series;\n    document.querySelector('[data-name=\"login title text\"]').textContent = text.title;\n    document.querySelector('[data-name=\"login subtitle text\"]').textContent = text.subtitle;\n    document.querySelector('[data-name=\"username label\"]').textContent = text.username;\n    document.querySelector('[data-name=\"password label\"]').textContent = text.password;\n    document.querySelector('[data-name=\"forgot password link\"]').textContent = text.forgot;\n    document.querySelector('[data-name=\"login submit button\"]').innerHTML = text.submit;\n    document.querySelector('[data-name=\"register link container\"]').innerHTML = `${text.signup} <a class=\"font-semibold text-white underline underline-offset-4\" href=\"register.php\">${text.create}</a>`;\n    document.getElementById('language-label').textContent = text.language;\n    document.querySelector('[data-name=\"footer service features text\"]').textContent = text.footer;\n    document.title = `${text.title} — Xtream IPTV`;\n    toggle.href = lang === 'ar' ? '?lang=en' : '?lang=ar';\n  };\n  const initial = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'ar';\n  setLanguage(initial);\n  toggle.addEventListener('click', (event) => {\n    event.preventDefault();\n    setLanguage(document.documentElement.lang === 'ar' ? 'en' : 'ar');\n  });\n})();\n</script>\n",
