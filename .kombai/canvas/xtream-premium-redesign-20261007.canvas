      "html": "<div class=\"min-h-screen bg-black text-white font-[Inter,system-ui,sans-serif]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n    .search-no-scrollbar::-webkit-scrollbar{display:none}\n    .search-no-scrollbar{scrollbar-width:none}\n    @media(max-width:700px){.catalog-main{padding-inline:20px!important}.catalog-header-links{display:none!important}.catalog-result{grid-template-columns:64px minmax(0,1fr)!important}.catalog-play{grid-column:1/-1;width:100%}.catalog-result img{width:64px!important;height:64px!important}.source-toggle{width:100%}.source-toggle button{flex:1}.query-row{align-items:stretch!important;flex-direction:column}.query-row select{width:100%!important}.tabs-wrap{overflow-x:auto}.intro-row{align-items:flex-start!important;flex-direction:column}.topbar{padding-inline:20px!important}}\n    @media(min-width:701px) and (max-width:960px){.catalog-main{padding-inline:32px!important}.catalog-result{grid-template-columns:76px minmax(0,1fr) auto!important}}\n    </style>\n    <header class=\"topbar flex h-[76px] items-center justify-between border-b border-[#242424] px-12\" data-kid=\"1-1\" data-name=\"header bar\">\n        <div class=\"flex items-center gap-8\" data-kid=\"1-1-1\" data-name=\"navigation left group\">\n            <a class=\"flex items-center gap-3 no-underline text-white\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-sm bg-[#e50914] text-lg font-extrabold text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon\">\n                    X\n                </span>\n                <span class=\"text-[17px] font-extrabold tracking-[0.12em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    XTREAM\n                </span>\n            </a>\n            <div class=\"catalog-header-links flex items-center gap-6 text-[13px] text-[#a8a8a8]\" data-kid=\"1-1-1-2\" data-name=\"navigation links group\">\n                <span class=\"font-semibold text-white\" data-kid=\"1-1-1-2-1\" data-name=\"active library navigation link\">\n                    المكتبة\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"my subscription navigation link\">\n                    اشتراكي\n                </span>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"profile navigation link\">\n                    الملف الشخصي\n                </span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-5\" data-kid=\"1-1-2\" data-name=\"navigation right group\">\n            <button class=\"rounded-sm border border-[#333] px-3 py-2 text-[12px] text-[#d0d0d0]\" data-kid=\"1-1-2-1\" data-name=\"language selector dropdown\">\n                العربية\n                <i class=\"bi bi-chevron-down ms-1\" data-kid=\"1-1-2-1-1\" data-name=\"chevron down icon\">\n                </i>\n            </button>\n            <span class=\"h-8 w-8 rounded-sm bg-[#252525] text-center leading-8 text-[13px] font-semibold text-[#ddd]\" data-kid=\"1-1-2-2\" data-name=\"user avatar placeholder\">\n                م\n            </span>\n        </div>\n    </header>\n    <main class=\"catalog-main mx-auto max-w-[1340px] px-12 pb-20 pt-11\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"intro-row mb-8 flex items-end justify-between gap-6\" data-kid=\"1-2-1\" data-name=\"intro row section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"intro title and description block\">\n                <h1 class=\"mb-2 text-[31px] font-bold tracking-[-0.035em]\" data-kid=\"1-2-1-1-1\" data-name=\"page headline title\">\n                    ابحث في مكتبتك\n                </h1>\n                <p class=\"mb-0 text-[14px] text-[#a8a8a8]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    اعثر على قناة أو عنوان داخل المصدر الذي اخترته.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-sm border border-[#303030] bg-[#111] px-3 py-2 text-[12px] text-[#aaa]\" data-kid=\"1-2-1-2\" data-name=\"search scope indicator\">\n                <i class=\"bi bi-broadcast-pin text-[#e50914]\" data-kid=\"1-2-1-2-1\" data-name=\"broadcast pin icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"search scope label\">\n                    نطاق البحث:\n                </span>\n                <strong class=\"font-semibold text-white\" data-kid=\"1-2-1-2-3\" data-name=\"search scope name\">\n                    Xtream فقط\n                </strong>\n            </div>\n        </div>\n        <section aria-label=\"المصدر والبحث\" class=\"mb-7 border-b border-[#242424] pb-7\" data-kid=\"1-2-2\" data-name=\"source and search settings section\">\n            <div class=\"mb-5 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-2-1\" data-name=\"source and info row\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"source toggle container\">\n                    <p class=\"mb-2 text-[12px] font-semibold text-[#c8c8c8]\" data-kid=\"1-2-2-1-1-1\" data-name=\"source toggle label\">\n                        المصدر الحالي\n                    </p>\n                    <div class=\"source-toggle inline-flex rounded-sm border border-[#343434] bg-[#111] p-1\" data-kid=\"1-2-2-1-1-2\" data-name=\"source toggle buttons container\">\n                        <button class=\"flex items-center gap-2 rounded-sm bg-[#242424] px-4 py-2.5 text-[13px] font-semibold text-white ring-1 ring-inset ring-[#3b3b3b]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"xtream source button\">\n                            <i class=\"bi bi-hdd-network text-[#e50914]\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"network icon\">\n                            </i>\n                            Xtream\n                            <i class=\"bi bi-check2 text-[#a8a8a8]\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"check icon\">\n                            </i>\n                        </button>\n                        <button class=\"flex items-center gap-2 rounded-sm px-4 py-2.5 text-[13px] font-medium text-[#999]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"m3u source button\">\n                            <i class=\"bi bi-link-45deg\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"link icon\">\n                            </i>\n                            M3U\n                        </button>\n                    </div>\n                </div>\n                <p class=\"mb-1 text-[12px] text-[#808080]\" data-kid=\"1-2-2-1-2\" data-name=\"results info text\">\n                    يتغير نطاق النتائج عند تبديل المصدر.\n                </p>\n            </div>\n            <label class=\"mb-2 block text-[13px] font-semibold text-[#f2f2f2]\" data-kid=\"1-2-2-2\" data-name=\"search input label\" for=\"catalog-search\">\n                ابحث في Xtream\n            </label>\n            <div class=\"query-row flex items-center gap-3\" data-kid=\"1-2-2-3\" data-name=\"search query input row\">\n                <div class=\"flex h-[54px] min-w-0 flex-1 items-center gap-3 rounded-sm border border-[#454545] bg-[#141414] px-4 focus-within:border-[#e50914]\" data-kid=\"1-2-2-3-1\" data-name=\"search input wrapper\">\n                    <i class=\"bi bi-search text-[16px] text-[#a8a8a8]\" data-kid=\"1-2-2-3-1-1\" data-name=\"search icon\">\n                    </i>\n                    <input aria-label=\"ابحث في Xtream\" class=\"min-w-0 flex-1 border-0 bg-transparent text-[15px] text-white outline-none placeholder:text-[#777]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-2\" data-name=\"search input field\" data-reason=\"value is dynamically managed by client search functionality\" id=\"catalog-search\" placeholder=\"اكتب اسم القناة...\" type=\"search\" value=\"beIN\"/>\n                    <button aria-label=\"مسح البحث\" class=\"flex h-7 w-7 items-center justify-center text-[#777]\" data-kid=\"1-2-2-3-1-3\" data-name=\"clear search button\">\n                        <i class=\"bi bi-x-circle\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"x icon\">\n                        </i>\n                    </button>\n                </div>\n                <button class=\"h-[54px] rounded-sm bg-[#e50914] px-6 text-[14px] font-bold text-white\" data-kid=\"1-2-2-3-2\" data-name=\"search submit button\">\n                    بحث\n                </button>\n            </div>\n            <p class=\"mb-0 mt-2 text-[12px] text-[#7e7e7e]\" data-kid=\"1-2-2-4\" data-name=\"search context help text\">\n                يعرض البحث نتائج المصدر المحدد فقط؛ لا يشمل مصادر أخرى.\n            </p>\n        </section>\n        <nav aria-label=\"نوع المحتوى\" class=\"tabs-wrap mb-6 flex items-center justify-between gap-4 border-b border-[#242424]\" data-kid=\"1-2-3\" data-name=\"content type navigation tabs\">\n            <div class=\"flex min-w-max items-center gap-7\" data-kid=\"1-2-3-1\" data-name=\"navigation tab buttons container\">\n                <button class=\"relative py-3 text-[14px] font-semibold text-white after:absolute after:bottom-[-1px] after:right-0 after:h-[2px] after:w-full after:bg-[#e50914]\" data-kid=\"1-2-3-1-1\" data-name=\"live broadcast tab button\">\n                    البث المباشر\n                </button>\n                <button class=\"py-3 text-[14px] font-medium text-[#a8a8a8]\" data-kid=\"1-2-3-1-2\" data-name=\"movies tab button\">\n                    الأفلام\n                </button>\n                <button class=\"py-3 text-[14px] font-medium text-[#a8a8a8]\" data-kid=\"1-2-3-1-3\" data-name=\"series tab button\">\n                    المسلسلات\n                </button>\n            </div>\n            <div class=\"hidden items-center gap-2 pb-1 text-[12px] text-[#777] sm:flex\" data-kid=\"1-2-3-2\" data-name=\"tab info note\">\n                <i class=\"bi bi-info-circle\" data-kid=\"1-2-3-2-1\" data-name=\"info icon\">\n                </i>\n                <span data-kid=\"1-2-3-2-2\" data-name=\"tab info text\">\n                    البحث هنا ضمن تبويب البث المباشر\n                </span>\n            </div>\n        </nav>\n        <div class=\"query-row mb-5 flex items-center justify-between gap-4\" data-kid=\"1-2-4\" data-name=\"results filter row\">\n            <div data-kid=\"1-2-4-1\" data-name=\"results summary block\">\n                <h2 class=\"mb-1 text-[19px] font-bold\" data-kid=\"1-2-4-1-1\" data-name=\"results section title\">\n                    نتائج البث المباشر\n                </h2>\n                <p class=\"mb-0 text-[12px] text-[#858585]\" data-kid=\"1-2-4-1-2\" data-name=\"results source info text\">\n                    من Xtream · الفئة: الكل\n                </p>\n            </div>\n            <label class=\"flex items-center gap-3 text-[12px] text-[#aaa]\" data-kid=\"1-2-4-2\" data-name=\"category filter dropdown wrapper\">\n                <span data-kid=\"1-2-4-2-1\" data-name=\"filter label\">\n                    الفئة\n                </span>\n                <select aria-label=\"فئة القنوات\" class=\"h-10 w-[210px] rounded-sm border border-[#333] bg-[#141414] px-3 text-[13px] text-[#eee] outline-none focus:border-[#e50914]\" data-kid=\"1-2-4-2-2\" data-name=\"filter select dropdown\">\n                    <option data-kid=\"1-2-4-2-2-1\" data-name=\"category option\">\n                        كل الفئات\n                    </option>\n                </select>\n            </label>\n        </div>\n        <div class=\"mb-3 grid grid-cols-[78px_minmax(0,1fr)_160px] items-center gap-5 border-b border-[#292929] px-4 py-2 text-[11px] font-semibold tracking-[0.04em] text-[#747474]\" data-kid=\"1-2-5\" data-name=\"results list header row\">\n            <span data-kid=\"1-2-5-1\" data-name=\"header logo label\">\n                الشعار\n            </span>\n            <span data-kid=\"1-2-5-2\" data-name=\"header channel label\">\n                القناة\n            </span>\n            <span class=\"text-left\" data-kid=\"1-2-5-3\" data-name=\"header action label\">\n                الإجراء\n            </span>\n        </div>\n        <article class=\"catalog-result grid grid-cols-[78px_minmax(0,1fr)_160px] items-center gap-5 border-b border-[#2b2b2b] px-4 py-5 transition-colors hover:bg-[#111]\" data-kid=\"1-2-6\" data-name=\"channel search result item\">\n            <div class=\"flex h-[68px] w-[78px] items-center justify-center overflow-hidden rounded-sm bg-white p-1.5\" data-kid=\"1-2-6-1\" data-name=\"channel logo wrapper\">\n                <img alt=\"شعار beIN SPORTS 1 بدقة 4K\" class=\"h-full w-full object-contain\" data-dynamic=\"true\" data-kid=\"1-2-6-1-1\" data-name=\"channel logo image\" data-reason=\"image source reinitialized by server path change\" decoding=\"async\" loading=\"lazy\" src=\"http://localhost/Xtream_Servers_Downloader/cache/images/server_1/live/9393d33bfc62c6e0a42367ea4baf12b7.png\"/>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-2-6-2\" data-name=\"channel info text block\">\n                <div class=\"mb-1 flex flex-wrap items-center gap-x-3 gap-y-1\" data-kid=\"1-2-6-2-1\" data-name=\"channel name and quality row\">\n                    <h3 class=\"m-0 truncate text-[16px] font-bold text-white\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-1\" data-name=\"channel title text\" data-reason=\"text set by search result object\">\n                        beIN SPORTS 1\n                    </h3>\n                    <span class=\"text-[10px] font-bold text-[#c8c8c8]\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-2\" data-name=\"channel quality tag\" data-reason=\"text set by search result object\">\n                        4K\n                    </span>\n                </div>\n                <p class=\"mb-0 text-[12px] text-[#929292]\" data-dynamic=\"true\" data-kid=\"1-2-6-2-2\" data-name=\"channel description text\" data-reason=\"text set by search result object\">\n                    قناة مباشرة · المصدر: Xtream\n                </p>\n            </div>\n            <button class=\"catalog-play flex h-10 items-center justify-center gap-2 rounded-sm bg-white px-4 text-[13px] font-bold text-black\" data-kid=\"1-2-6-3\" data-name=\"play channel button\">\n                <i class=\"bi bi-play-fill text-[17px]\" data-kid=\"1-2-6-3-1\" data-name=\"play icon\">\n                </i>\n                تشغيل القناة\n            </button>\n        </article>\n        <section class=\"mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-[#242424] pt-6\" data-kid=\"1-2-7\" data-name=\"footer help and navigation section\">\n            <div class=\"flex items-center gap-3 text-[12px] text-[#8b8b8b]\" data-kid=\"1-2-7-1\" data-name=\"security info container\">\n                <i class=\"bi bi-shield-lock text-[#666]\" data-kid=\"1-2-7-1-1\" data-name=\"shield icon\">\n                </i>\n                <span data-kid=\"1-2-7-1-2\" data-name=\"security info text\">\n                    كل النتائج تخص المصدر المختار، وتتغير عند تبديله.\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 text-[12px] text-[#8b8b8b]\" data-kid=\"1-2-7-2\" data-name=\"nav links footer group\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-7-2-1\" data-name=\"live nav link\">\n                    <i class=\"bi bi-tv text-[#a8a8a8]\" data-kid=\"1-2-7-2-1-1\" data-name=\"tv icon\">\n                    </i>\n                    البث المباشر\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-7-2-2\" data-name=\"movies nav link\">\n                    <i class=\"bi bi-film text-[#a8a8a8]\" data-kid=\"1-2-7-2-2-1\" data-name=\"film icon\">\n                    </i>\n                    الأفلام\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-7-2-3\" data-name=\"series nav link\">\n                    <i class=\"bi bi-collection-play text-[#a8a8a8]\" data-kid=\"1-2-7-2-3-1\" data-name=\"collection icon\">\n                    </i>\n                    المسلسلات\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n",
