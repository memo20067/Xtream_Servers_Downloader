      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#000000] text-[#ffffff]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\" style=\"font-family:Inter,'Noto Sans Arabic',sans-serif\">\n    <main class=\"mx-auto grid min-h-screen max-w-[1440px] grid-cols-1 items-center px-6 py-8 sm:px-10 lg:grid-cols-2 lg:gap-16 lg:px-20 lg:py-12\" data-kid=\"1-1\" data-name=\"main content layout grid\">\n        <section class=\"order-1 mx-auto flex w-full max-w-[430px] flex-col justify-center lg:mx-0 lg:justify-self-start\" data-kid=\"1-1-1\" data-name=\"login form section\">\n            <div class=\"mb-12 flex items-center justify-between\" data-kid=\"1-1-1-1\" data-name=\"header container\">\n                <div class=\"text-right\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and title group\">\n                    <a class=\"text-[27px] font-bold tracking-[-0.04em] text-white no-underline\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand name link\" href=\"#\">\n                        مَدار\n                    </a>\n                    <p class=\"mt-1 mb-0 text-[11px] tracking-[0.18em] text-[#777777]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand abbreviation subtitle\" dir=\"ltr\">\n                        M A D A R\n                    </p>\n                </div>\n                <button class=\"rounded-sm px-3 py-2 text-[13px] font-medium text-[#a8a8a8] underline decoration-[#555555] underline-offset-4 hover:text-white\" data-kid=\"1-1-1-1-2\" data-name=\"language selection button\" type=\"button\">\n                    English\n                </button>\n            </div>\n            <div class=\"mb-9\" data-kid=\"1-1-1-2\" data-name=\"login instruction header\">\n                <h1 class=\"mb-3 text-[31px] font-semibold leading-tight tracking-[-0.03em]\" data-kid=\"1-1-1-2-1\" data-name=\"login page title\">\n                    تسجيل الدخول\n                </h1>\n                <p class=\"mb-0 text-[14px] leading-6 text-[#a8a8a8]\" data-kid=\"1-1-1-2-2\" data-name=\"login subtitle text\">\n                    أدخل بيانات حسابك للمتابعة\n                </p>\n            </div>\n            <form action=\"#\" class=\"flex flex-col gap-5\" data-kid=\"1-1-1-3\" data-name=\"login input form\" method=\"post\">\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-1-1-3-1\" data-name=\"username input group\">\n                    <label class=\"text-[13px] font-medium text-[#e6e6e6]\" data-kid=\"1-1-1-3-1-1\" data-name=\"username label\" for=\"identity\">\n                        اسم المستخدم أو البريد الإلكتروني\n                    </label>\n                    <input autocomplete=\"username\" class=\"h-12 w-full rounded-sm border border-[#333333] bg-[#141414] px-4 text-[14px] text-white outline-none placeholder:text-[#6e6e6e] focus:border-[#e50914]\" data-kid=\"1-1-1-3-1-2\" data-name=\"username input field\" dir=\"auto\" id=\"identity\" name=\"username\" placeholder=\"name@example.com\" type=\"text\"/>\n                </div>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-1-1-3-2\" data-name=\"password input group\">\n                    <label class=\"text-[13px] font-medium text-[#e6e6e6]\" data-kid=\"1-1-1-3-2-1\" data-name=\"password label\" for=\"password\">\n                        كلمة المرور\n                    </label>\n                    <input autocomplete=\"current-password\" class=\"h-12 w-full rounded-sm border border-[#333333] bg-[#141414] px-4 text-[14px] tracking-[0.2em] text-white outline-none placeholder:text-[#6e6e6e] focus:border-[#e50914]\" data-kid=\"1-1-1-3-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n                </div>\n                <div class=\"mt-0.5 flex justify-start\" data-kid=\"1-1-1-3-3\" data-name=\"forgot password container\">\n                    <a class=\"text-[13px] text-[#a8a8a8] underline decoration-[#555555] underline-offset-4 hover:text-white\" data-kid=\"1-1-1-3-3-1\" data-name=\"forgot password link\" href=\"forgot_password.php\">\n                        نسيت كلمة المرور؟\n                    </a>\n                </div>\n                <button class=\"mt-2 h-12 w-full rounded-sm bg-[#e50914] px-5 text-[15px] font-semibold text-white hover:bg-[#b20710]\" data-kid=\"1-1-1-3-4\" data-name=\"submit login button\" type=\"submit\">\n                    تسجيل الدخول\n                </button>\n            </form>\n            <p class=\"mt-8 mb-0 text-[13px] text-[#a8a8a8]\" data-kid=\"1-1-1-4\" data-name=\"registration prompt text\">\n                ليس لديك حساب؟\n                <a class=\"ms-1 font-medium text-white underline decoration-[#777777] underline-offset-4 hover:decoration-white\" data-kid=\"1-1-1-4-1\" data-name=\"create account link\" href=\"register.php\">\n                    إنشاء حساب\n                </a>\n            </p>\n        </section>\n        <aside class=\"order-2 relative mt-14 hidden min-h-[620px] items-center justify-center border-r border-[#262626] lg:flex\" data-kid=\"1-1-2\" data-name=\"hero media sidebar\">\n            <div class=\"flex w-full max-w-[440px] flex-col items-center\" data-kid=\"1-1-2-1\" data-name=\"hero media container\">\n                <div class=\"relative h-[448px] w-[300px] overflow-hidden bg-[#141414]\" data-kid=\"1-1-2-1-1\" data-name=\"hero media poster box\">\n                    <img alt=\"ملصق مسلسل محفوظ ضمن محتوى المشروع\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-1-2-1-1-1\" data-name=\"hero media poster image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/cache/images/server_1/series/163873cd62df416de16bb5f1bd66f6e5.jpg\"/>\n                    <div class=\"absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/55 to-transparent\" data-kid=\"1-1-2-1-1-2\" data-name=\"poster gradient overlay\">\n                    </div>\n                </div>\n                <div class=\"mt-7 flex items-center gap-4 text-[12px] text-[#a8a8a8]\" data-kid=\"1-1-2-1-2\" data-name=\"media category tags container\">\n                    <span data-kid=\"1-1-2-1-2-1\" data-name=\"media category label 1\">\n                        بث مباشر\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-[#555555]\" data-kid=\"1-1-2-1-2-2\" data-name=\"separator dot 1\">\n                    </span>\n                    <span data-kid=\"1-1-2-1-2-3\" data-name=\"media category label 2\">\n                        أفلام\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-[#555555]\" data-kid=\"1-1-2-1-2-4\" data-name=\"separator dot 2\">\n                    </span>\n                    <span data-kid=\"1-1-2-1-2-5\" data-name=\"media category label 3\">\n                        مسلسلات\n                    </span>\n                </div>\n            </div>\n        </aside>\n    </main>\n</div>\n",
